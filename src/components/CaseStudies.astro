---
---
<section class="relative py-24 max-w-7xl mx-auto px-6" id="results">
  <!-- Title -->
  <div class="mb-14">
    <div class="font-mono text-xs text-terra-bright uppercase tracking-widest mb-3">DOCUMENTED CASE STUDIES</div>
    <h2 class="font-display text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
      Real Brands Scaled with <br>
      <span class="text-peach font-bold italic">PREDICTABLE META ADS.</span>
    </h2>
    <p class="text-white/60 text-base max-w-2xl leading-relaxed">
      No screenshots needed—see how we applied the right creative and funnel architecture to double and triple client sales.
    </p>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Case 1 -->
    <div class="glass-panel rounded-3xl p-7 flex flex-col justify-between transition-all hover:-translate-y-1">
      <div>
        <div class="font-mono text-xs text-peach uppercase tracking-wider mb-2">E-COMMERCE FASHION</div>
        <h3 class="font-display text-xl font-bold text-white mb-3">
          Women's Clothing Scaled From $120,000 to $850,000 Monthly Revenue
        </h3>
        <p class="text-white/60 text-xs leading-relaxed mb-6">
          Visual hook refresh and high-intent audience setup over 3 months eliminated budget waste and increased profit.
        </p>
      </div>

      <div class="bg-obsidian-950/70 border border-white/10 rounded-xl p-4 flex justify-between font-mono text-xs">
        <div>
          <span class="text-white/40 block text-[10px] uppercase">Blended ROAS</span>
          <span class="text-accent-mint font-bold text-lg">4.6x</span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <span class="text-white/40 block text-[10px] uppercase">Cost Per Order</span>
          <span class="text-peach font-bold text-lg">$210</span>
        </div>
      </div>
    </div>

    <!-- Case 2 -->
    <div class="glass-panel rounded-3xl p-7 flex flex-col justify-between transition-all hover:-translate-y-1">
      <div>
        <div class="font-mono text-xs text-peach uppercase tracking-wider mb-2">SKINCARE & BEAUTY</div>
        <h3 class="font-display text-xl font-bold text-white mb-3">
          High-Ticket D2C Brand Tripled Sales in Just 45 Days
        </h3>
        <p class="text-white/60 text-xs leading-relaxed mb-6">
          AI UGC video creative and cloud CAPI integration to recover customer drop-off and increase return.
        </p>
      </div>

      <div class="bg-obsidian-950/70 border border-white/10 rounded-xl p-4 flex justify-between font-mono text-xs">
        <div>
          <span class="text-white/40 block text-[10px] uppercase">Peak ROAS</span>
          <span class="text-accent-mint font-bold text-lg">5.2x</span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <span class="text-white/40 block text-[10px] uppercase">CPA Cut</span>
          <span class="text-peach font-bold text-lg">-44%</span>
        </div>
      </div>
    </div>

    <!-- Case 3 -->
    <div class="glass-panel rounded-3xl p-7 flex flex-col justify-between transition-all hover:-translate-y-1">
      <div>
        <div class="font-mono text-xs text-peach uppercase tracking-wider mb-2">SERVICE & COACHING</div>
        <h3 class="font-display text-xl font-bold text-white mb-3">
          High-Ticket Coaching: 420+ Qualified Leads at $1.82/Lead
        </h3>
        <p class="text-white/60 text-xs leading-relaxed mb-6">
          Integrated an instant lead form with automated WhatsApp follow-up system to increase conversion rate.
        </p>
      </div>

      <div class="bg-obsidian-950/70 border border-white/10 rounded-xl p-4 flex justify-between font-mono text-xs">
        <div>
          <span class="text-white/40 block text-[10px] uppercase">Lead-to-Call</span>
          <span class="text-accent-mint font-bold text-lg">68%</span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <span class="text-white/40 block text-[10px] uppercase">Cost Per Lead</span>
          <span class="text-peach font-bold text-lg">$1.82</span>
        </div>
      </div>
    </div>

  </div>
</section>
