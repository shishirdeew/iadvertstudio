---
import { DEFAULT_CONFIG } from '../lib/siteConfig';
const cfg = DEFAULT_CONFIG.sections.hero;
---
<section class="relative pt-36 pb-20 max-w-7xl mx-auto px-6 min-h-[92vh] flex flex-col justify-center z-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

    <!-- Hero Copy -->
    <div class="lg:col-span-7 flex flex-col items-start z-10">
      <!-- Tag -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-terra/10 border border-terra/30 font-mono text-xs text-peach mb-6 reveal reveal-left">
        <span class="w-2 h-2 rounded-full bg-accent-mint animate-ping"></span>
        <span id="live-hero-tag" data-cfg="sections.hero.tag">{cfg.tag}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold leading-[1.18] mb-6 text-white reveal reveal-left">
        {cfg.headline1} <br class="hidden sm:inline" />
        <span class="text-peach tracking-wide font-bold italic">{cfg.headline2}</span> <br class="hidden sm:inline" />
        <span class="text-terra-bright tracking-wide font-bold drop-shadow-[0_0_25px_rgba(224,72,50,0.5)]">{cfg.headline3}</span>
      </h1>

      <!-- English Subtitle -->
      <p id="live-hero-subtitle" data-cfg="sections.hero.subtitle" class="text-base sm:text-lg text-white/70 max-w-xl leading-relaxed mb-8 reveal reveal-left reveal-up reveal-delay-200">
        {cfg.subtitle}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-4 mb-12 reveal reveal-left reveal-delay-400">
        <a
          href={cfg.ctaHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm sm:text-base px-7 py-3.5 rounded-full border border-peach/25 shadow-xl shadow-terra/40 transition-all hover:scale-105 hover:shadow-terra/60"
        >
          <span id="live-hero-cta" data-cfg="sections.hero.ctaText">{cfg.ctaText}</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href={cfg.secondaryCtaHref}
          class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-white font-medium text-sm sm:text-base px-6 py-3.5 rounded-full border border-white/10 backdrop-blur-md transition-all hover:scale-105"
        >
          <span>{cfg.secondaryCtaText}</span>
        </a>
      </div>

      <!-- Trust Metrics -->
      <div class="w-full pt-6 border-t border-white/10 grid grid-cols-3 gap-2 sm:gap-6 reveal reveal-left reveal-delay-500">
        {cfg.metrics.map((m) => (
          <div>
            <div id={`live-hero-${m.id}`} data-cfg={`sections.hero.metrics.${m.id.split('metric')[1]-1}.value`} class="font-display font-bold text-lg sm:text-3xl text-peach whitespace-nowrap">{m.value}</div>
            <div class="text-[10px] sm:text-xs uppercase tracking-wider text-white/50 font-mono mt-1">{m.label}</div>
          </div>
        ))}
      </div>

      <!-- Scroll cue -->
      <div class="flex items-center gap-2 mt-8 ml-1 text-xs font-mono text-white/40 reveal reveal-left reveal-delay-600">
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
        <span>Explore the system</span>
      </div>
    </div>

    <!-- 3D Stage -->
    <div class="lg:col-span-5 relative h-[460px] sm:h-[520px] flex items-center justify-center perspective-[1200px]" id="hero-3d-stage">
      <canvas id="hero-three-canvas" class="w-full h-full rounded-3xl pointer-events-auto"></canvas>

      <!-- Floating 3D Metric Hologram Cards -->
      <div class="glass-card-3d absolute top-6 -left-4 sm:left-2 p-4 sm:p-5 rounded-2xl cursor-pointer" id="tilt-card-1">
        <div class="flex items-center gap-2 text-xs font-mono text-white/70 mb-1">
          <svg class="w-3.5 h-3.5 text-accent-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
          </svg>
          BLENDED ROAS
        </div>
        <div class="font-display font-extrabold text-2xl sm:text-3xl text-accent-mint">+380%</div>
        <svg class="w-28 sm:w-32 h-6 mt-1" viewBox="0 0 100 25">
          <path d="M0,20 Q20,18 35,12 T70,8 T100,2" fill="none" stroke="#00E599" stroke-width="2.5" />
          <path d="M0,20 Q20,18 35,12 T70,8 T100,2 L100,25 L0,25 Z" fill="rgba(0, 229, 153, 0.15)" />
        </svg>
      </div>

      <div class="glass-card-3d absolute bottom-8 -right-2 sm:right-2 p-4 sm:p-5 rounded-2xl cursor-pointer" id="tilt-card-2">
        <div class="flex items-center gap-2 text-xs font-mono text-white/70 mb-1">
          <span class="w-2 h-2 rounded-full bg-terra-bright"></span>
          SCALING ENGINE
        </div>
        <div class="font-display font-extrabold text-2xl sm:text-3xl text-peach">
          +124% <span class="text-xs font-normal text-white/50">MoM Growth</span>
        </div>
        <div class="text-[11px] font-mono text-accent-mint mt-1">✓ CBO Dynamic Scaling</div>
      </div>

      <div class="glass-card-3d absolute top-1/2 left-1/3 -translate-y-1/2 p-3 sm:p-4 rounded-xl border border-terra/40 bg-gradient-to-br from-obsidian-800/90 to-obsidian-900/95" id="tilt-card-3">
        <div class="flex items-center gap-1.5 text-[11px] font-mono text-peach">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          CAPI VERIFIED
        </div>
        <div class="text-xs font-bold text-white mt-1">100% Server-Side Data</div>
        <div class="text-[10px] font-mono text-accent-mint">● Zero iOS 14.5 Loss</div>
      </div>
    </div>

  </div>
</section>

<script>
  import * as THREE from 'three';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- THREE.JS INTERACTIVE 3D SCENE ---
  const canvas = document.getElementById('hero-three-canvas') as HTMLCanvasElement;
  const stage = document.getElementById('hero-3d-stage');

  if (!canvas || !stage) {
    console.log('Hero 3D elements missing');
  } else {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, stage.clientWidth / stage.clientHeight, 0.1, 1000);
    camera.position.z = 7;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(stage.clientWidth, stage.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Central Holographic Meta Ads Core
    const knotGeo = new THREE.TorusKnotGeometry(1.5, 0.35, 128, 16);
    const knotMat = new THREE.MeshStandardMaterial({
      color: 0xa83220,
      metalness: 0.85,
      roughness: 0.25,
      emissive: 0x4a1209,
      emissiveIntensity: 0.6,
    });
    const knot = new THREE.Mesh(knotGeo, knotMat);
    scene.add(knot);

    // Outer Wireframe Cage
    const cageGeo = new THREE.IcosahedronGeometry(2.5, 2);
    const cageMat = new THREE.MeshBasicMaterial({
      color: 0xffdad2,
      wireframe: true,
      transparent: true,
      opacity: 0.16,
    });
    const cage = new THREE.Mesh(cageGeo, cageMat);
    scene.add(cage);

    // Ambient Particle Field
    const particleCount = reduceMotion ? 40 : 160;
    const partGeo = new THREE.BufferGeometry();
    const partPos = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount * 3; i += 3) {
      partPos[i] = (Math.random() - 0.5) * 12;
      partPos[i + 1] = (Math.random() - 0.5) * 12;
      partPos[i + 2] = (Math.random() - 0.5) * 8;
    }
    partGeo.setAttribute('position', new THREE.BufferAttribute(partPos, 3));
    const partMat = new THREE.PointsMaterial({
      color: 0xe04832,
      size: 0.05,
      transparent: true,
      opacity: reduceMotion ? 0.4 : 0.7,
    });
    const particles = new THREE.Points(partGeo, partMat);
    scene.add(particles);

    // Lights
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const light1 = new THREE.PointLight(0xe04832, 3, 20);
    light1.position.set(4, 3, 4);
    scene.add(light1);

    const light2 = new THREE.PointLight(0xffdad2, 2, 20);
    light2.position.set(-4, -3, 2);
    scene.add(light2);

    // Mouse Interaction
    let mouseX = 0,
      mouseY = 0;
    let targetX = 0,
      targetY = 0;

    window.addEventListener(
      'mousemove',
      (e) => {
        const rect = stage.getBoundingClientRect();
        mouseX = ((e.clientX - rect.left) / stage.clientWidth - 0.5) * 2;
        mouseY = -((e.clientY - rect.top) / stage.clientHeight - 0.5) * 2;
      },
      { passive: true }
    );

    // 3D Tilt Card Parallax
    const card1 = document.getElementById('tilt-card-1');
    const card2 = document.getElementById('tilt-card-2');
    const card3 = document.getElementById('tilt-card-3');

    // Optimized rendering: pause when off-screen to save CPU and battery
    let visible = false;
    let animationFrameId: number | null = null;

    function renderLoop() {
      if (!visible) return;

      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      knot.rotation.x += 0.006;
      knot.rotation.y += 0.009;
      knot.rotation.x += targetY * 0.02;
      knot.rotation.y += targetX * 0.02;

      cage.rotation.y -= 0.003;
      particles.rotation.y += 0.001;

      if (card1)
        card1.style.transform = `translate(${targetX * 12}px, ${-targetY * 12}px)`;
      if (card2)
        card2.style.transform = `translate(${-targetX * 14}px, ${targetY * 14}px)`;
      if (card3)
        card3.style.transform = `translate(calc(-50% + ${targetX * 8}px), calc(-50% + ${-targetY * 8}px))`;

      renderer.render(scene, camera);

      if (!reduceMotion) {
        animationFrameId = requestAnimationFrame(renderLoop);
      }
    }

    const perfObserver = new IntersectionObserver(
      (entries) => {
        const isIntersecting = entries[0].isIntersecting;
        if (isIntersecting && !visible) {
          visible = true;
          renderLoop();
        } else if (!isIntersecting && visible) {
          visible = false;
          if (animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
          }
        }
      },
      { threshold: 0.05 }
    );
    perfObserver.observe(stage);

    window.addEventListener(
      'resize',
      () => {
        if (!stage.clientWidth || !stage.clientHeight) return;
        camera.aspect = stage.clientWidth / stage.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(stage.clientWidth, stage.clientHeight);
      },
      { passive: true }
    );
  }
</script>

<style>
  .reveal-left {
    transform: translateX(-14px);
    opacity: 0;
  }
  .reveal-left.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #hero-three-canvas {
      filter: none !important;
    }
  }
</style>