---
import { DEFAULT_CONFIG } from '../lib/siteConfig';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
const brand = DEFAULT_CONFIG.brand;
---
<footer class="border-t border-white/[0.08] py-14 text-xs text-white/40 font-sans">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

    <!-- Brand -->
    <div>
      <a href={homeUrl} class="inline-block" aria-label="iAdvert Studio home">
        <img
          src={`${base}/assets/logo.png`}
          alt="iAdvert Studio"
          width="1200"
          height="442"
          data-wp-img="logo"
          class="h-8 w-auto max-w-[160px] object-contain"
          loading="lazy"
        />
      </a>
      <p class="mt-4 leading-relaxed text-white/40 text-sm max-w-xs">
        iAdvert Studio is a Meta Ads agency based in Rajshahi, Bangladesh. We plan, launch, and optimize Facebook and Instagram ads for businesses in Bangladesh and beyond.
      </p>
    </div>

    <!-- Company links -->
    <nav aria-label="Company">
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Company</h5>
      <ul class="space-y-2.5 text-sm">
        <li><a href={homeUrl} class="hover:text-peach transition-colors">Home</a></li>
        <li><a href={`${base}/#services`} class="hover:text-peach transition-colors">Services</a></li>
        <li><a href={`${base}/#results`} class="hover:text-peach transition-colors">Case Studies</a></li>
        <li><a href={`${base}/blog`} class="hover:text-peach transition-colors">Blog</a></li>
        <li><a href={`${base}/#founder`} class="hover:text-peach transition-colors">About</a></li>
        <li><a href={`${base}/#contact`} class="hover:text-peach transition-colors">Contact</a></li>
        <li><a href={`${base}/privacy-policy`} class="hover:text-peach transition-colors">Privacy Policy</a></li>
      </ul>
    </nav>

    <!-- Contact -->
    <div id="contact">
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Contact</h5>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href={`mailto:${brand.email}`} data-cfg="brand.email" class="hover:text-peach transition-colors break-all">{brand.email}</a>
        </li>
        <li>
          <a href={`tel:${brand.phone.replace(/\D/g, '')}`} data-cfg="brand.phone" class="hover:text-peach transition-colors">{brand.phone}</a>
        </li>
        <li>
          <a href={`https://wa.me/${brand.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener" data-cfg="brand.whatsapp" class="hover:text-peach transition-colors">WhatsApp: {brand.whatsapp}</a>
        </li>
        <li data-cfg="brand.address" class="text-white/40">{brand.address}</li>
      </ul>
    </div>

    <!-- CTA -->
    <div>
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Have an idea or project?</h5>
      <p class="text-sm text-white/50 mb-4">Let's <em class="text-peach not-italic font-bold">TALK</em></p>
      <a
        href="mailto:inquiryiadverts@gmail.com"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm px-5 py-2.5 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105"
      >
        Email us
      </a>
    </div>
  </div>

  <!-- Social icons: small, reddish terra theme, consistent design -->
  <div class="max-w-7xl mx-auto px-6 mt-10">
    <div class="flex items-center justify-center gap-3">
      <a href="https://www.facebook.com/iAdvertStudio" target="_blank" rel="noopener" aria-label="Facebook Page" title="Facebook Page" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5z"/></svg>
      </a>
      <a href="https://www.instagram.com/iadvertstudio" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="https://www.linkedin.com/company/iadvertsm/" target="_blank" rel="noopener" aria-label="LinkedIn Page" title="LinkedIn Page" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9.5 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/ratulashishir/" target="_blank" rel="noopener" aria-label="LinkedIn Profile" title="LinkedIn Profile" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 9c-4.4 0-8 2.2-8 5v3h16v-3c0-2.8-3.6-5-8-5zm7.5-4.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></svg>
      </a>
      <a href="mailto:inquiryiadverts@gmail.com" target="_blank" rel="noopener" aria-label="Email" title="Email" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2zM3 8v10h18V8l-8 5-8-5z"/></svg>
      </a>
      <a href="https://wa.me/8801301843562" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.87 11.87 0 0012 2C6.5 2 2 6.5 2 12c0 2.12.55 4.12 1.5 5.9L2 22l6.1-1.5c1.78.95 3.78 1.5 5.9 1.5 5.5 0 10-4.5 10-10 0-2.68-1.06-5.2-2.96-7.08zm-9.02 15.48c-1.96 0-3.82-.52-5.43-1.44l-.39-.23-3.93.98.98-3.78-.26-.42A9.88 9.88 0 012.02 12c0-5.5 4.48-9.98 10.02-9.98s10.02 4.48 10.02 9.98-4.48 9.98-10 9.98zm5.32-7.3c-.28-.14-1.65-.81-1.9-.9-.25-.09-.44-.14-.62.14-.18.28-.7.9-.86 1.08-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.37-.83-.73-1.39-1.62-1.55-1.9-.16-.28-.02-.44.12-.58.12-.12.28-.32.42-.48.14-.16.18-.28.28-.46.09-.18.05-.34-.02-.48-.07-.14-.62-1.5-0.85-2.04-.23-.53-.46-.46-.62-.47-.16-.01-.34-.01-.52-.01-.18 0-.46.07-.7.34-.24.27-0.92.94-.92 2.29 0 1.35.98 2.66 1.12 2.85.14.18 1.98 3.03 4.8 4.25.67.29 1.2.46 1.61.59.68.22 1.3.19 1.79.12.55-.09 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.19-.53-.33z"/></svg>
      </a>
      <a href="https://youtube.com/@iadvertstudio" target="_blank" rel="noopener" aria-label="YouTube Channel" title="YouTube Channel" class="w-8 h-8 rounded-full border border-terra/30 bg-terra/10 flex items-center justify-center text-terra-bright hover:bg-terra hover:border-terra hover:text-white transition-all hover:scale-110">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z"/></svg>
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-10 pt-6 border-t border-white/[0.08] flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left text-xs text-white/40">
    <div class="space-y-1">
      <p id="secret-admin-trigger" class="cursor-default select-none transition-colors hover:text-white/60" title="iAdvert Studio">© {new Date().getFullYear()} iAdvert Studio. All rights reserved.</p>
      <p class="text-[11px] text-white/30">Meta™ and Facebook™ are trademarks of Meta Platforms, Inc.</p>
    </div>
    <div class="text-[11px] text-white/40 tracking-wide">
      Made with focus in Rajshahi, Bangladesh
    </div>
  </div>
</footer>

<script>
  // Secret admin access: 3 clicks on copyright or press Ctrl+Shift+A
  let clickCount = 0;
  let clickTimer: any = null;
  const trigger = document.getElementById('secret-admin-trigger');

  trigger?.addEventListener('click', () => {
    clickCount++;
    clearTimeout(clickTimer);
    if (clickCount >= 3) {
      window.location.href = '/dashboard';
    }
    clickTimer = setTimeout(() => {
      clickCount = 0;
    }, 1200);
  });

  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'a') {
      window.location.href = '/dashboard';
    }
  });
</script>
