---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---
<footer class="border-t border-white/[0.08] py-14 text-xs text-white/40 font-mono">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

    <!-- Brand -->
    <div>
      <a href={homeUrl} class="inline-block" aria-label="IAdvert Studio home">
        <img
          src={`${base}/assets/logo.png`}
          alt="IAdvert Studio"
          width="1200"
          height="442"
          class="h-8 w-auto max-w-[160px] object-contain"
          loading="lazy"
        />
      </a>
      <p class="mt-4 leading-relaxed text-white/40 font-sans text-sm max-w-xs">
        IAdvert Studio is a Meta Ads agency in Puthia, Rajshahi. We plan, launch and optimize Facebook and Instagram ads for businesses in Bangladesh and beyond.
      </p>
      <div class="mt-5 flex items-center gap-3">
        <a href="https://www.facebook.com/iAdvertStudio" target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 rounded-full border border-white/10 bg-white/5 hover:bg-terra hover:border-terra flex items-center justify-center text-white/70 hover:text-white transition-all hover:scale-110">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5z"/></svg>
        </a>
        <a href="https://www.instagram.com/iadvertstudio" target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 rounded-full border border-white/10 bg-white/5 hover:bg-terra hover:border-terra flex items-center justify-center text-white/70 hover:text-white transition-all hover:scale-110">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/iadvertsm/" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-9 h-9 rounded-full border border-white/10 bg-white/5 hover:bg-terra hover:border-terra flex items-center justify-center text-white/70 hover:text-white transition-all hover:scale-110">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9.5 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4z"/></svg>
        </a>
        <a href="https://youtube.com/@iadvertstudio" target="_blank" rel="noopener" aria-label="YouTube" class="w-9 h-9 rounded-full border border-white/10 bg-white/5 hover:bg-terra hover:border-terra flex items-center justify-center text-white/70 hover:text-white transition-all hover:scale-110">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.5s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.4-1C16.6 4 12 4 12 4s-4.6 0-7.7.2c-.5.1-1.5.1-2.4 1-.7.7-.9 2.3-.9 2.3S.8 9.4.8 11.3v1.4c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.6 1 1.9.2 7.5.2 7.5.2s4.6 0 7.7-.2c.5-.1 1.5-.1 2.4-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8v-1.4c0-1.9-.2-3.8-.2-3.8zM9.8 15.1V8.4l6.2 3.4-6.2 3.3z"/></svg>
        </a>
      </div>
    </div>

    <!-- Company links -->
    <nav aria-label="Company">
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Company</h5>
      <ul class="space-y-2.5 font-sans text-sm">
        <li><a href={homeUrl} class="hover:text-peach transition-colors">Home</a></li>
        <li><a href={`${base}/#services`} class="hover:text-peach transition-colors">Services</a></li>
        <li><a href={`${base}/#results`} class="hover:text-peach transition-colors">Case Studies</a></li>
        <li><a href={`${base}/#founder`} class="hover:text-peach transition-colors">About</a></li>
        <li><a href={`${base}/#contact`} class="hover:text-peach transition-colors">Contact</a></li>
        <li><a href={`${base}/privacy-policy`} class="hover:text-peach transition-colors">Privacy Policy</a></li>
      </ul>
    </nav>

    <!-- Contact -->
    <div id="contact">
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Contact</h5>
      <ul class="space-y-2.5 font-sans text-sm">
        <li>
          <a href="mailto:inquiryiadverts@gmail.com" class="hover:text-peach transition-colors break-all">inquiryiadverts@gmail.com</a>
        </li>
        <li>
          <a href="tel:+8801738632389" class="hover:text-peach transition-colors">+880 1738-632389</a>
        </li>
        <li>
          <a href="https://wa.me/8801301843562" target="_blank" rel="noopener" class="hover:text-peach transition-colors">WhatsApp: +880 1301-843562</a>
        </li>
        <li class="text-white/40">Shibpur Hat-6260, Puthia, Rajshahi</li>
      </ul>
    </div>

    <!-- CTA -->
    <div>
      <h5 class="font-display text-sm font-bold text-white uppercase tracking-widest mb-4">Have an idea or project?</h5>
      <p class="font-sans text-sm text-white/50 mb-4">Let's <em class="text-peach not-italic">talk</em></p>
      <a
        href="mailto:inquiryiadverts@gmail.com"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm px-5 py-2.5 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105"
      >
        Email us
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-12 pt-6 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-3">
    <div>© {new Date().getFullYear()} IAdvert Studio. Meta™ and Facebook™ are trademarks of Meta Platforms, Inc.</div>
    <div class="text-white/30">Made with focus in Rajshahi, Bangladesh</div>
  </div>
</footer>
