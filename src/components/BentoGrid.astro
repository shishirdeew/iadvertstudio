---
---
<section class="relative py-28 max-w-7xl mx-auto px-6 overflow-hidden" id="services">
  <!-- Subtle ambient liquid glow orbs behind glass (Apple visual depth) -->
  <div class="absolute -top-12 left-1/4 w-96 h-96 bg-terra/15 rounded-full blur-[120px] pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute -bottom-16 right-1/4 w-96 h-96 bg-peach/10 rounded-full blur-[140px] pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- Section Title -->
  <div class="mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full liquid-glass-inner text-[11px] font-mono text-terra-bright uppercase tracking-widest mb-4 reveal reveal-left">
      <span class="w-1.5 h-1.5 rounded-full bg-terra-bright animate-pulse"></span>
      THE 4-PILLAR META SYSTEM
    </div>
    <h2 class="font-display text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4 reveal reveal-left">
      How We Turn Ad Dollars <br />
      Into <span class="text-peach font-bold italic">BANK DEPOSITS.</span>
    </h2>
    <p class="text-white/60 text-base max-w-2xl leading-relaxed reveal reveal-left font-sans">
      No random boosting. We run a fully predictable scaling ecosystem built exclusively for the Facebook and Meta platforms.
    </p>
  </div>

  <!-- Bento Grid Container -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 relative z-10">

    <!-- Card 1: Creative & Copywriting (Span 7) -->
    <div class="md:col-span-7 liquid-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between group reveal reveal-left relative overflow-hidden">
      <!-- Top Specular Refraction Highlight -->
      <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div>
        <!-- Top bar with Pillar badge and Liquid Glass Icon -->
        <div class="flex items-center justify-between mb-7">
          <div class="w-12 h-12 rounded-2xl liquid-glass-icon flex items-center justify-center text-peach group-hover:scale-110 group-hover:border-peach/40 group-hover:shadow-[0_0_20px_rgba(255,218,210,0.25)] transition-all duration-300">
            <!-- Sparkles / High-Converting Creative Icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
              <path d="M19 3v4"/>
              <path d="M21 5h-4"/>
            </svg>
          </div>
          <span class="text-[11px] font-mono tracking-widest text-white/50 uppercase px-3 py-1 rounded-full liquid-glass-inner">
            PILLAR 01
          </span>
        </div>

        <h3 class="font-display text-2xl font-bold text-white mb-3 group-hover:text-peach transition-colors">
          High-Converting Creative &amp; Copywriting
        </h3>
        <p class="text-white/65 text-sm leading-relaxed mb-8 font-sans">
          Algorithms are now creative-driven. We craft first-3-second visual hooks, run psychological angle tests, and produce high-impact UGC creatives engineered to halt the scroll.
        </p>
      </div>

      <!-- Metric Widget: Liquid Glass Sub-capsule -->
      <div class="liquid-glass-inner rounded-2xl p-4.5 font-mono text-xs">
        <div class="flex justify-between items-center mb-2.5">
          <span class="text-white/70 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-mint animate-pulse"></span>
            3-Second Hook Retention
          </span>
          <span class="text-accent-mint font-bold px-2 py-0.5 rounded-md bg-accent-mint/10 border border-accent-mint/20">
            +48.6% vs Industry
          </span>
        </div>
        <div class="h-2 w-full bg-white/[0.08] rounded-full overflow-hidden p-[1px]">
          <div class="h-full bg-gradient-to-r from-terra-bright via-peach to-accent-mint w-[78%] rounded-full shadow-[0_0_10px_rgba(224,72,50,0.5)]"></div>
        </div>
      </div>
    </div>

    <!-- Card 2: Server-Side Meta CAPI (Span 5) -->
    <div class="md:col-span-5 liquid-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between group relative overflow-hidden">
      <!-- Top Specular Refraction Highlight -->
      <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between mb-7">
          <div class="w-12 h-12 rounded-2xl liquid-glass-icon flex items-center justify-center text-accent-mint group-hover:scale-110 group-hover:border-accent-mint/40 group-hover:shadow-[0_0_20px_rgba(46,213,115,0.25)] transition-all duration-300">
            <!-- Cloud Lightning / CAPI Signal Icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"/>
              <path d="m13 13-3 4h4l-2 5"/>
            </svg>
          </div>
          <span class="text-[11px] font-mono tracking-widest text-white/50 uppercase px-3 py-1 rounded-full liquid-glass-inner">
            PILLAR 02
          </span>
        </div>

        <h3 class="font-display text-2xl font-bold text-white mb-3 group-hover:text-accent-mint transition-colors">
          Bulletproof Meta CAPI
        </h3>
        <p class="text-white/65 text-sm leading-relaxed mb-8 font-sans">
          The era of browser pixels is over. Feed real conversion data directly to Meta via cloud server-side Conversions API for unshakeable tracking accuracy and lower CPAs.
        </p>
      </div>

      <!-- Metric Widget: Liquid Glass Sub-capsule -->
      <div class="liquid-glass-inner rounded-2xl p-4.5 font-mono text-xs border-accent-mint/20">
        <div class="flex items-center justify-between text-accent-mint font-bold mb-1.5">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-mint animate-pulse shadow-[0_0_8px_rgba(46,213,115,0.8)]"></span>
            Event Match Quality
          </span>
          <span class="px-2 py-0.5 rounded-md bg-accent-mint/10 border border-accent-mint/25">9.4 / 10</span>
        </div>
        <div class="text-white/45 text-[11px] pl-4">
          Deduplication Active (Browser + Cloud CAPI)
        </div>
      </div>
    </div>

    <!-- Card 3: Funnel Architecture (Span 5) -->
    <div class="md:col-span-5 liquid-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between group relative overflow-hidden">
      <!-- Top Specular Refraction Highlight -->
      <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between mb-7">
          <div class="w-12 h-12 rounded-2xl liquid-glass-icon flex items-center justify-center text-terra-bright group-hover:scale-110 group-hover:border-terra-bright/40 group-hover:shadow-[0_0_20px_rgba(224,72,50,0.25)] transition-all duration-300">
            <!-- Layered Funnel Architecture Icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m2 17 10 5 10-5"/>
              <path d="m2 12 10 5 10-5"/>
              <path d="m12 2 10 5-10 5-10-5Z"/>
            </svg>
          </div>
          <span class="text-[11px] font-mono tracking-widest text-white/50 uppercase px-3 py-1 rounded-full liquid-glass-inner">
            PILLAR 03
          </span>
        </div>

        <h3 class="font-display text-2xl font-bold text-white mb-3 group-hover:text-terra-bright transition-colors">
          Predictable Funnel Architecture
        </h3>
        <p class="text-white/65 text-sm leading-relaxed mb-8 font-sans">
          From cold prospecting to aggressive retargeting—surgical budget split engineered so every single dollar works with absolute maximum efficiency.
        </p>
      </div>

      <!-- Metric Widget: Liquid Glass Sub-capsule -->
      <div class="liquid-glass-inner rounded-2xl p-4.5 font-mono text-xs">
        <div class="flex items-center justify-between text-white/80 mb-2">
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-peach"></span><span class="text-peach font-bold">TOF:</span> 70%</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-white"></span><span class="text-white font-bold">MOF:</span> 20%</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-accent-mint"></span><span class="text-accent-mint font-bold">BOF:</span> 10%</div>
        </div>
        <div class="h-1.5 w-full bg-white/[0.08] rounded-full overflow-hidden flex">
          <div class="h-full bg-peach w-[70%]"></div>
          <div class="h-full bg-white/70 w-[20%]"></div>
          <div class="h-full bg-accent-mint w-[10%]"></div>
        </div>
      </div>
    </div>

    <!-- Card 4: Daily Signal Optimization & Scaling (Span 7) -->
    <div class="md:col-span-7 liquid-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between group reveal reveal-left relative overflow-hidden">
      <!-- Top Specular Refraction Highlight -->
      <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between mb-7">
          <div class="w-12 h-12 rounded-2xl liquid-glass-icon flex items-center justify-center text-peach group-hover:scale-110 group-hover:border-peach/40 group-hover:shadow-[0_0_20px_rgba(255,218,210,0.25)] transition-all duration-300">
            <!-- Scaling / Trend Up Analytics Icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
            </svg>
          </div>
          <span class="text-[11px] font-mono tracking-widest text-white/50 uppercase px-3 py-1 rounded-full liquid-glass-inner">
            PILLAR 04
          </span>
        </div>

        <h3 class="font-display text-2xl font-bold text-white mb-3 group-hover:text-peach transition-colors">
          Daily Signal Optimization &amp; Scaling
        </h3>
        <p class="text-white/65 text-sm leading-relaxed mb-8 font-sans">
          Fast killing of fatigue ads, aggressive scaling of winning hooks, and algorithmic audience cycling. Zero guessing—disciplined statistical execution.
        </p>
      </div>

      <!-- Metric Widget: Liquid Glass Sub-capsule -->
      <div class="liquid-glass-inner rounded-2xl p-4.5 flex items-center justify-around font-mono text-xs">
        <div class="text-center sm:text-left">
          <span class="text-white/50 block text-[10px] uppercase tracking-wider mb-0.5">CPA Reduction</span>
          <span class="text-peach text-lg font-bold drop-shadow-[0_0_12px_rgba(255,218,210,0.4)]">-34.8%</span>
        </div>
        <div class="w-px h-10 bg-white/10"></div>
        <div class="text-center sm:text-left">
          <span class="text-white/50 block text-[10px] uppercase tracking-wider mb-0.5">Client Net Margin</span>
          <span class="text-accent-mint text-lg font-bold drop-shadow-[0_0_12px_rgba(46,213,115,0.4)]">+42.5%</span>
        </div>
      </div>
    </div>

  </div>
</section>
