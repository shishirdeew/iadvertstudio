---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-obsidian-900/70 backdrop-blur-xl border-b border-white/[0.08] transition-all duration-300"
>
  <div class="header-inner max-w-7xl mx-auto px-5 sm:px-6 h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href={homeUrl} class="flex items-center gap-3 group shrink-0" aria-label="IAdvert Studio home">
      <img
        src={`${base}/assets/logo.png`}
        alt="IAdvert Studio"
        class="h-8 sm:h-10 w-auto max-h-10 max-w-[190px] sm:max-w-[240px] object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Navigation links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      <a href={`${base}/#services`} data-nav-link class="nav-link text-sm font-medium text-white/70 hover:text-white transition-colors">Meta Engine</a>
      <a href={`${base}/#calculator`} data-nav-link class="nav-link text-sm font-medium text-white/70 hover:text-white transition-colors">ROAS Simulator</a>
      <a href={`${base}/#results`} data-nav-link class="nav-link text-sm font-medium text-white/70 hover:text-white transition-colors">Case Studies</a>
      <a href={`${base}/#founder`} data-nav-link class="nav-link text-sm font-medium text-white/70 hover:text-white transition-colors">About</a>
      <a href={`${base}/privacy-policy`} class="nav-link text-sm font-medium text-white/70 hover:text-white transition-colors">Privacy</a>
    </nav>

    <!-- CTA + mobile toggle -->
    <div class="flex items-center gap-3">
      <a
        href="https://wa.me/8801301843562?text=Hello%20Ratul,%20I%20want%20a%20Free%20Meta%20Ads%20Audit%20for%20my%20business."
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white text-xs md:text-sm font-semibold tracking-wide uppercase px-5 md:px-6 py-2.5 md:py-3 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105 hover:shadow-terra/50"
      >
        <span>Claim Free Audit</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-white/10 bg-white/5 text-white hover:bg-white/10 transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10" />
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-white/[0.08] bg-obsidian-950/95 backdrop-blur-2xl">
    <nav class="px-5 py-5 flex flex-col gap-1" aria-label="Mobile">
      <a href="#services" class="mobile-link px-4 py-3 rounded-xl text-sm font-medium text-white/80 hover:text-white hover:bg-white/[0.06] transition-colors">Meta Engine</a>
      <a href="#calculator" class="mobile-link px-4 py-3 rounded-xl text-sm font-medium text-white/80 hover:text-white hover:bg-white/[0.06] transition-colors">ROAS Simulator</a>
      <a href="#results" class="mobile-link px-4 py-3 rounded-xl text-sm font-medium text-white/80 hover:text-white hover:bg-white/[0.06] transition-colors">Case Studies</a>
      <a href="#founder" class="mobile-link px-4 py-3 rounded-xl text-sm font-medium text-white/80 hover:text-white hover:bg-white/[0.06] transition-colors">About</a>
      <a
        href="https://wa.me/8801301843562?text=Hello%20Ratul,%20I%20want%20a%20Free%20Meta%20Ads%20Audit%20for%20my%20business."
        target="_blank"
        rel="noopener"
        class="mobile-link mt-3 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-terra-bright to-terra text-white text-sm font-semibold px-5 py-3.5 rounded-full shadow-lg shadow-terra/30"
      >
        Claim Free Audit
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </nav>
  </div>
</header>

<script>
  // Header shrink on scroll
  const header = document.getElementById('site-header');
  const onScrollHeader = () => {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScrollHeader, { passive: true });
  onScrollHeader();

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setMenu(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  menuBtn?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Active section highlighting
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = `#${entry.target.id}`;
        navLinks.forEach((link) => {
          const active = link.getAttribute('href') === id;
          link.classList.toggle('text-white', active);
          link.classList.toggle('text-white/70', !active);
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
  );

  sections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
  #site-header.scrolled {
    background: rgba(8, 7, 11, 0.92);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }
  #site-header.scrolled .header-inner {
    height: 4.25rem;
  }
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #e04832, #ffdad2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .nav-link:hover::after,
  .nav-link.text-white::after {
    transform: scaleX(1);
  }
</style>
