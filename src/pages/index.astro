---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import RoasCalculator from '../components/RoasCalculator.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Founder from '../components/Founder.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
---

<Layout title="iAdvert Studio | Premier Meta & Facebook Ads Agency">
  <Navbar />
  <main id="main-content-canvas">
    <div id="sec-hero" data-section="hero"><Hero /></div>
    <div id="sec-marquee" data-section="marquee"><Marquee /></div>
    <div id="sec-services" data-section="services"><BentoGrid /></div>
    <div id="sec-calculator" data-section="calculator"><RoasCalculator /></div>
    <div id="sec-results" data-section="results"><CaseStudies /></div>
    <div id="sec-founder" data-section="founder"><Founder /></div>
    <div id="sec-cta" data-section="cta"><CtaSection /></div>
  </main>
  <Footer />
</Layout>

<script>
  // Live sync with Site Customizer overrides from Admin Dashboard
  try {
    const raw = localStorage.getItem('iadverts_custom_site_content');
    if (raw) {
      const c = JSON.parse(raw);
      if (c.heroTag) {
        const el = document.getElementById('live-hero-tag');
        if (el) el.textContent = c.heroTag;
      }
      if (c.heroSubtitle) {
        const el = document.getElementById('live-hero-subtitle');
        if (el) el.textContent = c.heroSubtitle;
      }
      if (c.heroCta) {
        const el = document.getElementById('live-hero-cta');
        if (el) el.textContent = c.heroCta;
      }
      // Fixed metric IDs (Hero uses live-hero-metric1, not live-hero-metric-1)
      if (c.metric1) {
        const el = document.getElementById('live-hero-metric1');
        if (el) el.textContent = c.metric1;
      }
      if (c.metric2) {
        const el = document.getElementById('live-hero-metric2');
        if (el) el.textContent = c.metric2;
      }
      if (c.metric3) {
        const el = document.getElementById('live-hero-metric3');
        if (el) el.textContent = c.metric3;
      }
      if (c.founderName) {
        const el = document.getElementById('live-founder-name');
        if (el) el.textContent = c.founderName;
      }
      if (c.founderQuote) {
        const el = document.getElementById('live-founder-quote');
        if (el) el.textContent = c.founderQuote;
      }
      if (c.ctaHeadline) {
        const el = document.getElementById('live-cta-headline');
        if (el) el.textContent = c.ctaHeadline;
      }
      if (c.ctaBtn) {
        const el = document.getElementById('live-cta-btn');
        if (el) el.textContent = c.ctaBtn;
      }
    }
  } catch (e) {
    // Graceful fallback
  }

  // Section Reordering from WordPress Site Editor (Appearance -> Patterns)
  // FIX: Only reorder if ALL sections are present, otherwise skip to prevent broken layout
  try {
    const rawOrder = localStorage.getItem('wp_section_order');
    if (rawOrder) {
      const order: string[] = JSON.parse(rawOrder);
      const expectedSections = ['hero', 'marquee', 'services', 'calculator', 'results', 'founder', 'cta'];
      // Only apply if order is complete and valid
      const isValidOrder = Array.isArray(order) && 
        order.length === expectedSections.length && 
        expectedSections.every(s => order.includes(s));
      
      if (isValidOrder) {
        const canvas = document.getElementById('main-content-canvas');
        if (canvas) {
          order.forEach(id => {
            const el = document.getElementById(`sec-${id}`);
            if (el) canvas.appendChild(el);
          });
        }
      }
    }
  } catch (e) {}
</script>