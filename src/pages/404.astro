---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout
  title="404 - Page Not Found | iAdvert Studio"
  description="The page you are looking for does not exist or has been moved. Explore iAdvert Studio for Meta Ads scaling, CAPI setups, and blog insights."
>
  <Navbar />

  <main class="pt-36 pb-28 min-h-[80vh] flex items-center justify-center">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="liquid-glass rounded-3xl p-8 sm:p-14 border border-white/15 relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent" aria-hidden="true"></div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full liquid-glass-inner text-[11px] font-mono text-terra-bright uppercase tracking-widest mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-terra-bright animate-ping"></span>
          SIGNAL NOT FOUND • ERROR 404
        </div>

        <h1 class="font-display text-4xl sm:text-6xl font-bold text-white tracking-tight mb-4">
          Lost in the <span class="text-peach font-bold italic">ALGORITHM?</span>
        </h1>

        <p class="text-white/60 text-base sm:text-lg mb-8 font-sans max-w-md mx-auto leading-relaxed">
          The page or campaign link you followed does not exist. Let's redirect you back to high-converting territory.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={homeUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm px-7 py-3.5 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105"
          >
            <span>Back to Home</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>

          <a
            href={`${base}/blog`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 liquid-glass-inner text-white/80 hover:text-white font-medium text-sm px-6 py-3.5 rounded-full transition-colors"
          >
            <span>Explore Blog Articles</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
