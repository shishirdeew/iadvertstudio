              <circle cx="12" cy="13" r="4"></circle>
            </svg>
            <span class="text-[10px] hidden sm:inline">Change</span>
          </button>
        </div>

        <!-- Content Details -->
        <div class="p-5 sm:p-6 flex flex-col flex-1">
          <h4 class="font-display text-base sm:text-lg font-bold text-white leading-snug line-clamp-2 mb-2 group-hover:text-peach transition-colors">
            ${post.title}
          </h4>
          <p class="text-white/60 text-xs line-clamp-2 mb-4 font-sans leading-relaxed">
            ${post.description}
          </p>

          <div class="mt-auto pt-3 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-white/40">
            <span>${post.readTime}</span>
            <span>${post.pubDate}</span>
          </div>

          <!-- Action Buttons Bar -->
          <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between gap-2 text-xs font-mono">
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                data-edit-post="${post.slug}"
