---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout
  title="Admin CMS & Performance Dashboard | iAdvert Studio"
  description="All-in-one control center for iAdvert Studio: manage blog publications, change cover pictures, configure SEO & SERP previews, edit site settings, and monitor live Meta Ads ROAS."
>
  <Navbar />

  <main class="pt-28 md:pt-36 pb-24 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <!-- Top Dashboard Header & Status Banner -->
      <section class="mb-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 pb-6 border-b border-white/[0.08]">
          <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full liquid-glass-inner text-[11px] font-mono text-accent-mint">
                <span class="w-2 h-2 rounded-full bg-accent-mint animate-pulse shadow-[0_0_8px_rgba(46,213,115,0.8)]"></span>
                SYSTEM OPERATIONAL
              </span>
              <span class="text-white/40 text-xs font-mono">•</span>
              <span class="text-white/60 text-xs font-mono">CMS Suite v2.4 (Live Sync)</span>
              <span class="text-white/40 text-xs font-mono">•</span>
              <span class="text-peach text-xs font-mono">Rajshahi, BD</span>
            </div>
            <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
              Control <span class="text-peach font-bold italic">PANEL.</span>
            </h1>
            <p class="text-white/60 text-sm sm:text-base mt-2 font-sans max-w-2xl">
              WordPress &amp; Shopify style studio control center: publish articles, upload cover pictures, optimize Google SERP SEO, update site identity, and monitor ad scale.
            </p>
          </div>

          <!-- Quick Actions & Status -->
          <div class="flex flex-wrap items-center gap-3">
            <div class="liquid-glass-inner px-4 py-2.5 rounded-2xl flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-terra/20 border border-terra/30 flex items-center justify-center text-peach text-sm font-bold">
                iA
              </div>
              <div>
                <div class="text-xs font-semibold text-white">iAdvert Studio Admin</div>
                <div class="text-[10px] text-accent-mint font-mono flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-mint"></span> Local Storage Synced
                </div>
              </div>
            </div>

            <a
              href={`${base}/blog`}
              target="_blank"
              class="liquid-glass-inner hover:bg-white/10 text-white/80 hover:text-white px-4 py-2.5 rounded-2xl text-xs font-mono inline-flex items-center gap-2 transition-all"
            >
              <span>View Public Blog</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Main Navigation Tabs (Liquid Glass Pill Bar) -->
      <section class="mb-8">
        <div class="liquid-glass p-1.5 rounded-2xl flex items-center gap-1.5 overflow-x-auto no-scrollbar" id="dashboard-nav-tabs">
          <button
            type="button"
            data-tab="blog"
            class="dash-tab active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-white/10 border border-white/15 shadow-sm transition-all whitespace-nowrap flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            <span>Blog &amp; Posts CMS</span>
            <span class="text-[10px] font-mono bg-peach/20 text-peach px-2 py-0.5 rounded-full" id="badge-post-count">5</span>
          </button>

          <button
            type="button"
            data-tab="seo"
            class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-accent-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>SEO &amp; SERP Suite</span>
          </button>

          <button
            type="button"
            data-tab="settings"
            class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-terra-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Site &amp; Brand Settings</span>
          </button>

          <button
            type="button"
            data-tab="media"
            class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Media Library</span>
          </button>

          <button
            type="button"
            data-tab="analytics"
            class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-accent-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Meta Ads Analytics</span>
          </button>
        </div>
      </section>

      <!-- TAB CONTENT PANELS -->

      <!-- ========================================== -->
      <!-- TAB 1: BLOG & POSTS CMS -->
      <!-- ========================================== -->
      <div id="tab-panel-blog" class="dash-panel space-y-8">
        
        <!-- Action Toolbar -->
        <div class="liquid-glass rounded-3xl p-5 sm:p-6 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="btn-create-post"
              class="bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white text-xs sm:text-sm font-semibold tracking-wide uppercase px-5 py-2.5 rounded-xl border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Create New Post</span>
            </button>

            <!-- Category Filter -->
            <div class="liquid-glass-inner px-2 py-1 rounded-xl flex items-center gap-1 text-xs font-mono" id="cms-category-filter">
              <button type="button" data-cat="all" class="cat-filter-btn active px-3 py-1.5 rounded-lg text-white bg-white/10 font-bold border border-white/10 transition-all">All</button>
              <button type="button" data-cat="Meta Ads" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white transition-all">Meta Ads</button>
              <button type="button" data-cat="CAPI" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white transition-all">CAPI</button>
              <button type="button" data-cat="Creative" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white transition-all">Creative</button>
              <button type="button" data-cat="Strategy" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white transition-all">Strategy</button>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Search bar -->
            <div class="relative flex-1 md:w-64">
              <input
                type="text"
                id="cms-search-input"
                placeholder="Search articles..."
                class="w-full bg-obsidian-950/70 border border-white/10 rounded-xl px-3.5 py-2 pl-9 text-xs font-mono text-white placeholder-white/40 focus:outline-none focus:border-peach"
              />
              <svg class="w-3.5 h-3.5 text-white/40 absolute left-3 top-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>

            <!-- Export / Backup -->
            <button
              type="button"
              id="btn-export-json"
              title="Export all posts to JSON backup"
              class="liquid-glass-inner hover:bg-white/10 text-white/70 hover:text-white px-3 py-2 rounded-xl text-xs font-mono flex items-center gap-1.5 transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span class="hidden sm:inline">Export</span>
            </button>

            <button
              type="button"
              id="btn-reset-posts"
              title="Reset to default 5 blog posts"
              class="liquid-glass-inner hover:bg-white/10 text-white/50 hover:text-terra-bright px-3 py-2 rounded-xl text-xs font-mono transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Articles Grid / Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cms-posts-container">
          <!-- Dynamically populated by JS from localStorage -->
        </div>

      </div>

      <!-- ========================================== -->
      <!-- TAB 2: SEO & SERP SUITE -->
      <!-- ========================================== -->
      <div id="tab-panel-seo" class="dash-panel hidden space-y-8">
        
        <!-- Page Selector Header -->
        <div class="liquid-glass rounded-3xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h2 class="font-display text-2xl font-bold text-white">Google SERP &amp; Meta Suite</h2>
            <p class="text-white/60 text-xs sm:text-sm font-sans mt-1">Live search engine result page simulator &amp; automated snippet score generator</p>
          </div>
          <div class="flex items-center gap-3">
            <label for="seo-page-select" class="text-xs font-mono text-white/60">Target Page:</label>
            <select
              id="seo-page-select"
              class="bg-obsidian-900 border border-white/15 text-white text-xs font-mono rounded-xl px-3.5 py-2 focus:outline-none focus:border-peach"
            >
              <option value="home">Homepage (https://iadverts.site/)</option>
              <option value="blog">Blog Archive (https://iadverts.site/blog)</option>
              <option value="tripled-roas">Article: Tripled ROAS Case Study</option>
              <option value="capi-checklist">Article: CAPI Setup Checklist</option>
              <option value="calculator">ROAS Simulator (/#calculator)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Left: SEO Editor Inputs (Span 7) -->
          <div class="lg:col-span-7 space-y-6">
            <div class="liquid-glass rounded-3xl p-6 sm:p-7 space-y-5">
              
              <!-- Meta Title -->
              <div>
                <div class="flex items-center justify-between mb-2">
                  <label for="seo-title-input" class="text-xs font-mono uppercase tracking-wider text-white/80">Meta Page Title</label>
                  <span id="seo-title-counter" class="text-[11px] font-mono text-accent-mint font-bold">58 / 60 chars (Optimal)</span>
                </div>
                <input
                  type="text"
                  id="seo-title-input"
                  value="How We Tripled ROAS for a D2C Beauty Brand in 45 Days | iAdvert Studio"
                  class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-peach font-sans"
                />
                <div class="w-full bg-white/10 h-1.5 rounded-full mt-2 overflow-hidden">
                  <div id="seo-title-bar" class="bg-accent-mint h-full transition-all duration-300" style="width: 96%"></div>
                </div>
              </div>

              <!-- Meta Description -->
              <div>
                <div class="flex items-center justify-between mb-2">
                  <label for="seo-desc-input" class="text-xs font-mono uppercase tracking-wider text-white/80">Meta Description</label>
                  <span id="seo-desc-counter" class="text-[11px] font-mono text-accent-mint font-bold">152 / 160 chars (Optimal)</span>
                </div>
                <textarea
                  id="seo-desc-input"
                  rows="3"
                  class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-white focus:outline-none focus:border-peach font-sans leading-relaxed"
                >Using AI UGC creative and cloud CAPI integration, we recovered 28% drop-off and turned casual browsers into repeat buyers while cutting CPA by 44%.</textarea>
                <div class="w-full bg-white/10 h-1.5 rounded-full mt-2 overflow-hidden">
                  <div id="seo-desc-bar" class="bg-accent-mint h-full transition-all duration-300" style="width: 95%"></div>
                </div>
              </div>

              <!-- Focus Keywords -->
              <div>
                <label for="seo-keywords-input" class="text-xs font-mono uppercase tracking-wider text-white/80 block mb-2">Target Focus Keywords (comma-separated)</label>
                <input
                  type="text"
                  id="seo-keywords-input"
                  value="Meta Ads ROAS, CAPI Tracking, UGC Ads, Scaled E-Commerce, Bangladesh Agency"
                  class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2.5 text-xs font-mono text-peach focus:outline-none focus:border-peach"
                />
              </div>

              <!-- OpenGraph Image URL -->
              <div>
                <label for="seo-og-image-input" class="text-xs font-mono uppercase tracking-wider text-white/80 block mb-2">OpenGraph Social Share Image (1200x630)</label>
                <div class="flex items-center gap-2">
                  <input
                    type="text"
                    id="seo-og-image-input"
                    value="https://iadverts.site/assets/hero-3d-concept.jpg"
                    class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2.5 text-xs font-mono text-white/90 focus:outline-none focus:border-peach"
                  />
                  <button
                    type="button"
                    id="btn-seo-choose-image"
                    class="liquid-glass-inner hover:bg-white/10 text-white/80 px-3.5 py-2.5 rounded-xl text-xs font-mono shrink-0"
                  >
                    Browse
                  </button>
                </div>
              </div>

              <!-- Copy Meta Tags Code -->
              <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between">
                <span class="text-xs font-mono text-white/50">Auto-generated HTML snippet</span>
                <button
                  type="button"
                  id="btn-copy-meta"
                  class="bg-peach/10 hover:bg-peach/20 text-peach border border-peach/30 px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all flex items-center gap-2"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy Meta Tags HTML</span>
                </button>
              </div>

            </div>

            <!-- SEO Health Matrix Checklist -->
            <div class="liquid-glass rounded-3xl p-6 space-y-3 font-mono text-xs">
              <h3 class="text-sm font-display font-bold text-white mb-3">On-Page SEO Health Audit</h3>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03]">
                <span class="text-white/70">Title tag length</span>
                <span class="text-accent-mint font-bold flex items-center gap-1">✓ 58 chars (Optimal)</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03]">
                <span class="text-white/70">Meta description length</span>
                <span class="text-accent-mint font-bold flex items-center gap-1">✓ 152 chars (Optimal)</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03]">
                <span class="text-white/70">XML Sitemap Indexing</span>
                <span class="text-accent-mint font-bold flex items-center gap-1">✓ /sitemap.xml (9 URLs Active)</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03]">
                <span class="text-white/70">Search Engine Robots</span>
                <span class="text-accent-mint font-bold flex items-center gap-1">✓ index, follow allowed</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03]">
                <span class="text-white/70">Canonical URL declaration</span>
                <span class="text-accent-mint font-bold flex items-center gap-1">✓ https://iadverts.site/</span>
              </div>
            </div>

          </div>

          <!-- Right: Live Previews (Span 5) -->
          <div class="lg:col-span-5 space-y-6">
            
            <!-- Google SERP Card Simulator -->
            <div class="liquid-glass rounded-3xl p-6">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono uppercase tracking-wider text-white/50 flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#4285F4]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"></path>
                  </svg>
                  Google Search Snippet
                </span>
                
                <!-- View toggle -->
                <div class="liquid-glass-inner p-1 rounded-xl flex items-center text-[10px] font-mono" id="serp-device-toggle">
                  <button type="button" data-view="desktop" class="serp-view-btn active px-2.5 py-1 rounded-lg text-white bg-white/10 font-bold">Desktop</button>
                  <button type="button" data-view="mobile" class="serp-view-btn px-2.5 py-1 rounded-lg text-white/60 hover:text-white">Mobile</button>
                </div>
              </div>

              <!-- Google Mock Result Container -->
              <div id="google-serp-preview-box" class="bg-[#202124] rounded-2xl p-5 border border-white/10 font-sans text-left transition-all">
                <!-- Favicon & Breadcrumb -->
                <div class="flex items-center gap-2.5 mb-2">
                  <div class="w-6 h-6 rounded-full bg-terra/20 border border-terra/40 flex items-center justify-center text-[10px] text-peach font-bold">
                    iA
                  </div>
                  <div>
                    <div class="text-[12px] text-[#bdc1c6] font-medium leading-none">iAdvert Studio</div>
                    <div class="text-[10px] text-[#9aa0a6] leading-none mt-0.5 truncate max-w-[280px]" id="serp-url-display">https://iadverts.site › blog › tripled-roas-beauty</div>
                  </div>
                </div>

                <!-- Clickable Title -->
                <h4 id="serp-title-display" class="text-[18px] text-[#8ab4f8] hover:underline cursor-pointer font-medium leading-snug mb-1">
                  How We Tripled ROAS for a D2C Beauty Brand in 45 Days | iAdvert Studio
                </h4>

                <!-- Snippet Description -->
                <p id="serp-desc-display" class="text-[13px] text-[#bdc1c6] leading-relaxed">
                  Using AI UGC creative and cloud CAPI integration, we recovered 28% drop-off and turned casual browsers into repeat buyers while cutting CPA by 44%.
                </p>
              </div>
            </div>

            <!-- Social Card (Facebook / LinkedIn) Simulator -->
            <div class="liquid-glass rounded-3xl p-6">
              <span class="text-xs font-mono uppercase tracking-wider text-white/50 block mb-4">
                Social Share Card Preview (OpenGraph)
              </span>

              <div class="bg-[#18191a] rounded-2xl overflow-hidden border border-white/10 font-sans">
                <!-- Banner Image -->
                <div class="relative h-44 w-full bg-obsidian-950 overflow-hidden">
                  <img
                    id="og-card-image"
                    src={`${base}/assets/hero-3d-concept.jpg`}
                    alt="Social Card Banner"
