  const coverModal = document.getElementById('modal-cover-changer');
  const changerPostTitle = document.getElementById('changer-post-title');
  const changerPostSlug = document.getElementById('changer-post-slug') as HTMLInputElement;
  const changerPreviewImg = document.getElementById('changer-preview-img') as HTMLImageElement;
  const changerUrlInput = document.getElementById('changer-url-input') as HTMLInputElement;
  const changerDropzone = document.getElementById('changer-dropzone');
  const changerFileInput = document.getElementById('changer-file-input') as HTMLInputElement;

  function openCoverChangerModal(slug: string) {
    if (!coverModal) return;
    const post = getStoredPosts().find(p => p.slug === slug);
    if (!post) return;

    changerPostSlug.value = post.slug;
    changerPostTitle!.textContent = post.title;
    changerPreviewImg.src = post.image;
    changerUrlInput.value = post.image;

    coverModal.classList.remove('hidden');
  }

  function closeCoverChangerModal() {
    coverModal?.classList.add('hidden');
  }

  document.getElementById('btn-close-cover-modal')?.addEventListener('click', closeCoverChangerModal);
  document.getElementById('btn-cancel-cover')?.addEventListener('click', closeCoverChangerModal);

  changerUrlInput?.addEventListener('input', () => {
    changerPreviewImg.src = changerUrlInput.value;
  });

  changerDropzone?.addEventListener('click', () => changerFileInput.click());
  changerFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const base64 = event.target?.result as string;
        changerUrlInput.value = base64;
        changerPreviewImg.src = base64;
        showToast('Photo loaded into preview!');
      };
      reader.readAsDataURL(file);
    }
  });

  document.getElementById('btn-apply-cover')?.addEventListener('click', () => {
    const slug = changerPostSlug.value;
    const newImage = changerUrlInput.value.trim() || changerPreviewImg.src;
    const posts = getStoredPosts();
    const target = posts.find(p => p.slug === slug);
    if (target) {
      target.image = newImage;
      saveStoredPosts(posts);
      renderPosts();
      closeCoverChangerModal();
      showToast('Cover picture updated successfully!');
    }
  });

  // ================================================================
  // SEO & SERP SUITE MANAGEMENT
  // ================================================================
  const seoPageSelect = document.getElementById('seo-page-select') as HTMLSelectElement;
  const seoTitleInput = document.getElementById('seo-title-input') as HTMLInputElement;
  const seoDescInput = document.getElementById('seo-desc-input') as HTMLTextAreaElement;
  const seoKeywordsInput = document.getElementById('seo-keywords-input') as HTMLInputElement;
  const seoOgImageInput = document.getElementById('seo-og-image-input') as HTMLInputElement;

  const seoTitleCounter = document.getElementById('seo-title-counter');
  const seoDescCounter = document.getElementById('seo-desc-counter');
  const seoTitleBar = document.getElementById('seo-title-bar');
  const seoDescBar = document.getElementById('seo-desc-bar');

  const serpUrlDisplay = document.getElementById('serp-url-display');
  const serpTitleDisplay = document.getElementById('serp-title-display');
  const serpDescDisplay = document.getElementById('serp-desc-display');
  const ogCardImage = document.getElementById('og-card-image') as HTMLImageElement;
  const ogCardTitle = document.getElementById('og-card-title');
  const ogCardDesc = document.getElementById('og-card-desc');

  const SEO_PROFILES: Record<string, { title: string; desc: string; url: string; keywords: string; ogImage: string }> = {
    'home': {
      title: 'iAdvert Studio | High-Performance Meta Ads Agency & CAPI Tracking',
      desc: 'We engineer high-converting Meta ad campaigns and server-side CAPI tracking for scaling brands. Predictable ROAS with zero signal loss.',
      url: 'https://iadverts.site/',
      keywords: 'Meta Ads Agency, Facebook Ads Agency Bangladesh, CAPI Tracking, ROAS Scaling',
      ogImage: '/assets/hero-3d-concept.jpg'
    },
    'blog': {
      title: 'Meta Ads Blog & Scaling Insights | iAdvert Studio',
      desc: 'Proven frameworks, psychological creative strategies, server-side CAPI setups, and scaling playbooks from iAdvert Studio.',
      url: 'https://iadverts.site/blog',
      keywords: 'Meta Ads Blog, Ad Creative Psychology, CAPI Checklist, ROAS Strategies',
      ogImage: '/assets/hero-3d-concept.jpg'
    },
    'tripled-roas': {
      title: 'How We Tripled ROAS for a D2C Beauty Brand in 45 Days | iAdvert Studio',
      desc: 'Using AI UGC creative and cloud CAPI integration, we recovered 28% drop-off and turned casual browsers into repeat buyers while cutting CPA by 44%.',
      url: 'https://iadverts.site/blog/tripled-roas-beauty',
      keywords: 'D2C ROAS Case Study, UGC Ads Testing, Server-Side CAPI, Scale E-Commerce',
      ogImage: '/assets/hero-3d-concept.jpg'
    },
    'capi-checklist': {
      title: 'The Complete CAPI Setup Checklist for 2027 | iAdvert Studio',
      desc: 'A step-by-step walkthrough of the Conversions API implementation that protects your ad data against iOS changes and ensures accurate attribution.',
      url: 'https://iadverts.site/blog/capi-setup-checklist',
      keywords: 'CAPI Setup, Stape.io Meta Events, Conversions API Checklist, EMQ Score',
      ogImage: '/assets/hero-3d-concept.jpg'
    },
    'calculator': {
      title: 'Meta Ads ROAS Simulator & Revenue Calculator | iAdvert Studio',
      desc: 'Calculate your projected revenue, blended ROAS, and customer acquisition costs before scaling your Meta ad spend.',
      url: 'https://iadverts.site/#calculator',
      keywords: 'ROAS Calculator, Meta Ad Spend Simulator, Ad Revenue Forecaster',
      ogImage: '/assets/hero-3d-concept.jpg'
    }
  };

  function updateSeoDisplays() {
    const title = seoTitleInput.value;
    const desc = seoDescInput.value;
    const ogImg = seoOgImageInput.value;

    // Counters & Status bars
    if (seoTitleCounter) {
      const len = title.length;
      const status = len >= 50 && len <= 60 ? 'Optimal' : len < 50 ? 'Too short' : 'Too long';
      seoTitleCounter.textContent = `${len} / 60 chars (${status})`;
      seoTitleCounter.className = `text-[11px] font-mono font-bold ${len >= 50 && len <= 60 ? 'text-accent-mint' : 'text-peach'}`;
      if (seoTitleBar) seoTitleBar.style.width = `${Math.min(100, (len / 60) * 100)}%`;
    }

    if (seoDescCounter) {
      const len = desc.length;
      const status = len >= 140 && len <= 160 ? 'Optimal' : len < 140 ? 'Too short' : 'Too long';
      seoDescCounter.textContent = `${len} / 160 chars (${status})`;
      seoDescCounter.className = `text-[11px] font-mono font-bold ${len >= 140 && len <= 160 ? 'text-accent-mint' : 'text-peach'}`;
      if (seoDescBar) seoDescBar.style.width = `${Math.min(100, (len / 160) * 100)}%`;
    }

    // Google SERP live updates
    if (serpTitleDisplay) serpTitleDisplay.textContent = title;
    if (serpDescDisplay) serpDescDisplay.textContent = desc;

    // Social card updates
    if (ogCardTitle) ogCardTitle.textContent = title;
    if (ogCardDesc) ogCardDesc.textContent = desc;
    if (ogCardImage) ogCardImage.src = ogImg;
  }

  seoPageSelect?.addEventListener('change', () => {
    const profile = SEO_PROFILES[seoPageSelect.value] || SEO_PROFILES['home'];
    seoTitleInput.value = profile.title;
    seoDescInput.value = profile.desc;
    seoKeywordsInput.value = profile.keywords;
    seoOgImageInput.value = profile.ogImage;
    if (serpUrlDisplay) serpUrlDisplay.textContent = profile.url;
    updateSeoDisplays();
  });

  seoTitleInput?.addEventListener('input', updateSeoDisplays);
  seoDescInput?.addEventListener('input', updateSeoDisplays);
  seoOgImageInput?.addEventListener('input', updateSeoDisplays);

  // SERP device toggle (desktop / mobile view)
  document.querySelectorAll<HTMLButtonElement>('.serp-view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.serp-view-btn').forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-white/10', 'font-bold');
        b.classList.add('text-white/60');
      });
      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-bold');
      btn.classList.remove('text-white/60');

      const view = btn.getAttribute('data-view');
      const serpBox = document.getElementById('google-serp-preview-box');
      if (serpBox) {
        if (view === 'mobile') {
          serpBox.classList.add('max-w-xs', 'mx-auto', 'border-peach/30');
        } else {
          serpBox.classList.remove('max-w-xs', 'mx-auto', 'border-peach/30');
        }
      }
    });
  });

  // Copy meta tags HTML to clipboard
  document.getElementById('btn-copy-meta')?.addEventListener('click', () => {
    const title = seoTitleInput.value;
    const desc = seoDescInput.value;
    const keywords = seoKeywordsInput.value;
    const ogImg = seoOgImageInput.value;
    const url = serpUrlDisplay?.textContent || 'https://iadverts.site/';

    const metaTags = `<!-- Primary Meta Tags -->
<title>${title}</title>
<meta name="title" content="${title}">
<meta name="description" content="${desc}">
<meta name="keywords" content="${keywords}">
<link rel="canonical" href="${url}">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="${url}">
<meta property="og:title" content="${title}">
<meta property="og:description" content="${desc}">
<meta property="og:image" content="${ogImg}">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="${url}">
<meta property="twitter:title" content="${title}">
<meta property="twitter:description" content="${desc}">
<meta property="twitter:image" content="${ogImg}">`;

    navigator.clipboard.writeText(metaTags).then(() => {
      showToast('Meta tags HTML copied to clipboard!');
    });
  });

  // ================================================================
  // BRAND & SITE SETTINGS
  // ================================================================
  interface BrandSettings {
    brandName: string;
    founder: string;
    tagline: string;
    phone: string;
    whatsapp: string;
    email: string;
    address: string;
    socialFb: string;
    socialWa: string;
  }

  const DEFAULT_SETTINGS: BrandSettings = {
    brandName: 'iAdvert Studio',
    founder: 'Ratul Ahmed Shishir',
    tagline: 'High-Performance Meta Ads & Server-Side CAPI Attribution Agency',
    phone: '+880 1301-843562',
    whatsapp: '+880 1301-843562',
    email: 'inquiryiadverts@gmail.com',
    address: 'Rajshahi, Bangladesh',
    socialFb: 'https://www.facebook.com/iadvertstudio',
    socialWa: 'https://wa.me/8801301843562'
  };

  function loadSettings() {
    const raw = localStorage.getItem('iadverts_site_settings');
    const s: BrandSettings = raw ? JSON.parse(raw) : DEFAULT_SETTINGS;

    (document.getElementById('setting-brand-name') as HTMLInputElement).value = s.brandName;
    (document.getElementById('setting-founder') as HTMLInputElement).value = s.founder;
    (document.getElementById('setting-tagline') as HTMLInputElement).value = s.tagline;
    (document.getElementById('setting-phone') as HTMLInputElement).value = s.phone;
    (document.getElementById('setting-whatsapp') as HTMLInputElement).value = s.whatsapp;
    (document.getElementById('setting-email') as HTMLInputElement).value = s.email;
    (document.getElementById('setting-address') as HTMLInputElement).value = s.address;
    (document.getElementById('setting-social-fb') as HTMLInputElement).value = s.socialFb;
    (document.getElementById('setting-social-wa') as HTMLInputElement).value = s.socialWa;
  }

  function saveSettings() {
    const s: BrandSettings = {
      brandName: (document.getElementById('setting-brand-name') as HTMLInputElement).value.trim(),
      founder: (document.getElementById('setting-founder') as HTMLInputElement).value.trim(),
      tagline: (document.getElementById('setting-tagline') as HTMLInputElement).value.trim(),
      phone: (document.getElementById('setting-phone') as HTMLInputElement).value.trim(),
      whatsapp: (document.getElementById('setting-whatsapp') as HTMLInputElement).value.trim(),
      email: (document.getElementById('setting-email') as HTMLInputElement).value.trim(),
      address: (document.getElementById('setting-address') as HTMLInputElement).value.trim(),
      socialFb: (document.getElementById('setting-social-fb') as HTMLInputElement).value.trim(),
      socialWa: (document.getElementById('setting-social-wa') as HTMLInputElement).value.trim()
    };
    localStorage.setItem('iadverts_site_settings', JSON.stringify(s));
    showToast('Brand settings & Rajshahi address saved!');
  }

  document.getElementById('btn-save-settings')?.addEventListener('click', saveSettings);
  document.getElementById('btn-restore-brand')?.addEventListener('click', () => {
    if (confirm('Reset contact and address to default values?')) {
      localStorage.setItem('iadverts_site_settings', JSON.stringify(DEFAULT_SETTINGS));
      loadSettings();
      showToast('Settings restored to defaults.');
    }
  });

  // ================================================================
  // MEDIA LIBRARY MANAGER
  // ================================================================
  function renderMedia() {
    const grid = document.getElementById('media-assets-grid');
    const countBadge = document.getElementById('media-count-badge');
    if (!grid) return;

    const mediaList = getStoredMedia();
    if (countBadge) countBadge.textContent = `${mediaList.length} Assets in Library`;

    grid.innerHTML = mediaList.map(asset => `
      <div class="liquid-glass rounded-2xl overflow-hidden border border-white/10 group flex flex-col justify-between">
        <div class="relative h-32 bg-obsidian-950 overflow-hidden flex items-center justify-center p-2">
          <img
            src="${asset.url}"
            alt="${asset.name}"
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
            onerror="this.src='/assets/hero-3d-concept.jpg'"
          />
        </div>
        <div class="p-3 bg-obsidian-900/60 border-t border-white/[0.06] text-xs font-mono">
          <div class="text-white font-medium truncate mb-1" title="${asset.name}">${asset.name}</div>
          <div class="flex items-center justify-between text-[10px] text-white/40 mb-2.5">
            <span>${asset.dimensions}</span>
            <span>${asset.size}</span>
          </div>
          <button
            type="button"
            data-copy-url="${asset.url}"
            class="w-full liquid-glass-inner hover:bg-white/10 text-peach text-[11px] py-1.5 rounded-lg flex items-center justify-center gap-1.5 transition-colors"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Copy URL</span>
          </button>
        </div>
      </div>
    `).join('');

    grid.querySelectorAll('[data-copy-url]').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-copy-url');
        if (url) {
          navigator.clipboard.writeText(url).then(() => {
            showToast('Asset URL copied to clipboard!');
          });
        }
      });
    });
  }

  // Media drag and drop
  const mediaDropzone = document.getElementById('media-dropzone');
  const mediaFileInput = document.getElementById('media-file-input') as HTMLInputElement;

  mediaDropzone?.addEventListener('click', () => mediaFileInput.click());
  mediaFileInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) {
      Array.from(files).forEach(file => {
        const reader = new FileReader();
        reader.onload = (event) => {
          const base64 = event.target?.result as string;
          const media = getStoredMedia();
          media.unshift({
            id: 'm_' + Date.now() + Math.random().toString(36).substring(7),
            name: file.name,
            url: base64,
            dimensions: '1920 × 1080',
            size: `${(file.size / 1024).toFixed(1)} KB`
          });
          saveStoredMedia(media);
          renderMedia();
          showToast(`Uploaded ${file.name} to media library!`);
        };
        reader.readAsDataURL(file);
      });
    }
  });

  // ================================================================
  // META ADS ANALYTICS LOGIC (From previous implementation)
  // ================================================================
  const rangeBtns = document.querySelectorAll('.range-btn');
  const kpiSpend = document.getElementById('kpi-spend');
  const kpiRevenue = document.getElementById('kpi-revenue');
  const kpiRoas = document.getElementById('kpi-roas');
  const kpiCpa = document.getElementById('kpi-cpa');

  const rangeData: Record<string, { spend: string; revenue: string; roas: string; cpa: string }> = {
    '7d': { spend: '$6,420', revenue: '$41,200', roas: '6.41x', cpa: '$16.20' },
    '30d': { spend: '$24,850', revenue: '$148,200', roas: '5.96x', cpa: '$18.40' },
    '90d': { spend: '$68,400', revenue: '$382,900', roas: '5.59x', cpa: '$19.10' }
  };

  rangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rangeBtns.forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10', 'shadow-sm');
        b.classList.add('text-white/60');
      });
      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10', 'shadow-sm');
      btn.classList.remove('text-white/60');

      const range = btn.getAttribute('data-range') ?? '30d';
      const data = rangeData[range];
      if (data && kpiSpend && kpiRevenue && kpiRoas && kpiCpa) {
        kpiSpend.textContent = data.spend;
        kpiRevenue.textContent = data.revenue;
        kpiRoas.textContent = data.roas;
        kpiCpa.textContent = data.cpa;
      }
    });
  });

  const filterBtns = document.querySelectorAll('.filter-btn');
  const tableRows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-category]');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10');
        b.classList.add('text-white/60');
      });
      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10');
      btn.classList.remove('text-white/60');

      const filter = btn.getAttribute('data-filter') ?? 'all';
      tableRows.forEach(row => {
        const cat = row.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });

  // Initial runs on DOM load
  renderPosts();
  renderMedia();
  loadSettings();
  updateSeoDisplays();
</script>
