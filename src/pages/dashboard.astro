---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_CONFIG } from '../lib/siteConfig';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WordPress 6.6 Admin Dashboard | iAdvert Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,700;1,500&family=Playfair+Display:wght@600;700&family=Syne:wght@600;700;800&family=Outfit:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              wpdark: '#1d2327',
              wpsidebar: '#101517',
              wpblue: '#2271b1',
              wphover: '#135e96',
              terra: '#e04832',
              peach: '#ffdad2',
              mint: '#2ed573'
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
              display: ['"Lora"', 'serif'],
              mono: ['"JetBrains Mono"', 'monospace']
            }
          }
        }
      }
    </script>
    <style>
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-track { background: #101517; }
      ::-webkit-scrollbar-thumb { background: #2c3338; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #3c434a; }
      .wp-sub-active { background: #2271b1 !important; color: #ffffff !important; }
      .drag-over { border-color: #2271b1 !important; background: rgba(34, 113, 177, 0.1) !important; }
    </style>
  </head>
  <body class="bg-[#101517] text-[#f0f0f1] font-sans antialiased min-h-screen flex flex-col selection:bg-wpblue selection:text-white">

    <!-- ================================================================ -->
    <!-- MASTER SECURITY LOCK GATE -->
    <!-- ================================================================ -->
    <div id="wp-auth-gate" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#0c0a10] p-4">
      <div class="bg-[#1d2327] border border-white/10 rounded-2xl p-8 max-w-sm w-full shadow-2xl text-center">
        <!-- WordPress Iconic Logo -->
        <div class="w-16 h-16 rounded-full bg-[#2271b1]/20 border border-[#2271b1]/50 mx-auto flex items-center justify-center text-white mb-5 shadow-lg">
          <svg class="w-9 h-9 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878L5.61 8.877C6.398 8.835 7.37 8.76 7.37 8.76c.484-.04.423-.748-.06-.748 0 0-1.474.12-2.422.12-.14 0-.363-.02-.625-.04C6.07 4.928 8.832 3.4 12 3.4c2.613 0 4.961 1.042 6.674 2.735L14.7 17.587l-2.607-7.79c.484-.04.484-.748 0-.748 0 0-1.473.12-2.42.12-.122 0-.283-.02-.485-.02L12 2zm0 18.6c-.663 0-1.304-.073-1.921-.212L13.883 9.4l3.774 10.384C16.14 20.25 14.16 20.6 12 20.6zm7.264-4.83l-3.21-8.815c.485-.04.908-.08.908-.08.484-.04.423-.748-.06-.748 0 0-1.474.12-2.422.12-.08 0-.203-.02-.343-.02l3.447 9.897c.72-1.127 1.258-2.39 1.564-3.754.076-.34.116-.69.116-1.04v-.002c0-.55-.084-1.077-.234-1.572.58 1.88.89 3.876.89 5.944 0 .02 0 .04-.002.06a8.558 8.558 0 0 1-.654.99zM3.4 12c0 1.547.398 2.997 1.087 4.267L9.58 4.28C5.976 5.378 3.4 8.41 3.4 12z"></path>
          </svg>
        </div>

        <h2 class="text-xl font-bold text-white mb-1">WordPress 6.6 CMS</h2>
        <p class="text-xs text-white/50 mb-6 font-mono">iAdvert Studio • Administrator Gateway</p>

        <form id="wp-login-form" class="space-y-4 text-left">
          <div>
            <label class="block text-xs font-mono text-white/70 mb-1.5">Username</label>
            <input type="text" value="admin" readonly class="w-full bg-[#101517] border border-white/15 rounded-lg px-3 py-2 text-xs font-mono text-white/80 focus:outline-none" />
          </div>
          <div>
            <label for="wp-login-pwd" class="block text-xs font-mono text-white/70 mb-1.5">Master Security Password</label>
            <input type="password" id="wp-login-pwd" placeholder="Enter password..." class="w-full bg-[#101517] border border-white/20 rounded-lg px-3 py-2 text-xs font-mono text-white focus:outline-none focus:border-wpblue" required />
          </div>
          <div id="wp-login-error" class="hidden text-[11px] font-mono text-red-400 bg-red-950/40 border border-red-800/50 p-2 rounded">
            Incorrect master password.
          </div>
          <button type="submit" class="w-full bg-[#2271b1] hover:bg-[#135e96] text-white font-medium text-xs py-2.5 rounded-lg transition-colors">
            Log In to WP Dashboard
          </button>
        </form>

        <div class="mt-5 pt-4 border-t border-white/10 text-[10px] font-mono text-white/40">
          Default Master Key: <span class="text-peach select-all">admin@iadvert2027</span>
        </div>
      </div>
    </div>

    <!-- ================================================================ -->
    <!-- AUTHENTICATED WP ADMIN SUITE -->
    <!-- ================================================================ -->
    <div id="wp-app-container" class="hidden flex-col flex-1 min-h-screen" style="display:none">

      <!-- ================================================================ -->
      <!-- TOP WORDPRESS ADMIN BAR -->
      <!-- ================================================================ -->
      <header class="h-8 bg-[#1d2327] border-b border-[#2c3338] flex items-center justify-between px-3 text-xs text-[#c3c4c7] select-none shrink-0 z-50">
        <div class="flex items-center gap-4">
          <!-- WP W Logo -->
          <a href="#" class="hover:text-white flex items-center gap-1.5" title="WordPress 6.6">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878L5.61 8.877C6.398 8.835 7.37 8.76 7.37 8.76c.484-.04.423-.748-.06-.748 0 0-1.474.12-2.422.12-.14 0-.363-.02-.625-.04C6.07 4.928 8.832 3.4 12 3.4c2.613 0 4.961 1.042 6.674 2.735L14.7 17.587l-2.607-7.79c.484-.04.484-.748 0-.748 0 0-1.473.12-2.42.12-.122 0-.283-.02-.485-.02L12 2zm0 18.6c-.663 0-1.304-.073-1.921-.212L13.883 9.4l3.774 10.384C16.14 20.25 14.16 20.6 12 20.6z"></path></svg>
          </a>

          <!-- Site Title with Home Icon -->
          <a href={homeUrl} target="_blank" class="hover:text-white flex items-center gap-1.5 font-medium text-white" title="Visit Site">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span>iAdvert Studio</span>
          </a>

          <!-- Comments Bubble -->
          <div class="hidden sm:flex items-center gap-1 hover:text-white cursor-pointer" title="0 Comments in moderation">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <span class="bg-[#2c3338] text-[10px] px-1.5 py-0.2 rounded-full">0</span>
          </div>

          <!-- + New Dropdown Button -->
          <button type="button" id="wp-top-btn-new" class="flex items-center gap-1 hover:text-white font-medium">
            <span class="text-white">+</span>
            <span>New</span>
          </button>
        </div>

        <div class="flex items-center gap-3">
          <!-- Live Status -->
          <span class="hidden md:inline-flex items-center gap-1.5 text-[11px] font-mono text-mint">
            <span class="w-2 h-2 rounded-full bg-mint animate-pulse"></span>
            Astro Static Live Sync Active
          </span>

          <!-- Publish Site Config -->
          <button type="button" id="btn-wp-publish-config" class="flex items-center gap-1.5 bg-[#2271b1] hover:bg-[#135e96] text-white font-medium text-[11px] px-2.5 py-1 rounded transition-colors" title="Generate and download site-config.json containing all edits, then deploy">
            <span class="font-bold">↑</span>
            <span>Publish Config</span>
          </button>

          <!-- User Profile & Log Out -->
          <div class="flex items-center gap-2">
            <span class="text-white font-medium">Howdy, Ratul Ahmed Shishir</span>
            <div class="w-5 h-5 rounded-full bg-terra/40 text-peach text-[10px] font-bold flex items-center justify-center border border-white/20">R</div>
            <button type="button" id="btn-wp-logout" class="text-red-400 hover:text-red-300 ml-2 font-mono text-[11px]">Log Out</button>
          </div>
        </div>
      </header>

      <div class="flex flex-1">
        
        <!-- ================================================================ -->
        <!-- LEFT WORDPRESS SIDEBAR (11 SECTIONS) -->
        <!-- ================================================================ -->
        <aside class="w-56 bg-[#1d2327] border-r border-[#2c3338] shrink-0 select-none flex flex-col justify-between py-2 text-[13px] font-sans">
          <nav class="space-y-0.5" id="wp-sidebar-nav">
            
            <!-- 1. DASHBOARD -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-dashboard" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-white bg-[#2271b1] font-medium hover:bg-[#2271b1]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                  <span>Dashboard</span>
                </span>
              </button>
            </div>

            <!-- SEPARATOR -->
            <div class="h-px bg-[#2c3338] my-1"></div>

            <!-- 2. POSTS (Articles) -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-posts" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                  <span>Posts</span>
                </span>
                <span class="bg-[#2c3338] text-[10px] text-white/80 px-1.5 py-0.2 rounded-full" id="wp-sidebar-post-count">5</span>
              </button>
            </div>

            <!-- 3. MEDIA -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-media" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                  <span>Media</span>
                </span>
              </button>
            </div>

            <!-- 4. PAGES -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-pages" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <span>Pages</span>
                </span>
                <span class="text-[10px] font-mono text-white/50">4</span>
              </button>
            </div>

            <!-- 5. COMMENTS -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-comments" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                  <span>Comments</span>
                </span>
              </button>
            </div>

            <!-- SEPARATOR -->
            <div class="h-px bg-[#2c3338] my-1"></div>

            <!-- 6. APPEARANCE (Site Editor, Styles, Patterns) -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-appearance" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path></svg>
                  <span class="font-semibold text-white">Appearance</span>
                </span>
                <span class="text-[9px] uppercase bg-terra/40 text-peach px-1 rounded">Editor</span>
              </button>
            </div>

            <!-- 7. PLUGINS -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-plugins" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"></path></svg>
                  <span>Plugins</span>
                </span>
                <span class="bg-mint/20 text-mint text-[10px] px-1 rounded">6 Active</span>
              </button>
            </div>

            <!-- 8. USERS -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-users" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  <span>Users</span>
                </span>
              </button>
            </div>

            <!-- 9. TOOLS -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-tools" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                  <span>Tools</span>
                </span>
              </button>
            </div>

            <!-- 10. SETTINGS -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-settings" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                  <span>Settings</span>
                </span>
              </button>
            </div>

            <!-- SEPARATOR -->
            <div class="h-px bg-[#2c3338] my-1"></div>

            <!-- 11. AD OPS & CAPI ENGINE (Studio Special) -->
            <div class="wp-menu-group">
              <button type="button" data-pane="pane-analytics" class="wp-menu-btn w-full px-3 py-2 text-left flex items-center justify-between text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#13171a]">
                <span class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                  <span class="text-mint font-semibold">Meta Analytics</span>
                </span>
                <span class="text-[9px] bg-mint/20 text-mint px-1 rounded">5.96x</span>
              </button>
            </div>

          </nav>

          <!-- Sidebar Bottom Footnote -->
          <div class="px-3 py-2 text-[11px] font-mono text-white/30 border-t border-[#2c3338]">
            WordPress 6.6.2 • Astro Engine
          </div>
        </aside>

        <!-- ================================================================ -->
        <!-- MAIN WORKSPACE CONTENT PANE -->
        <!-- ================================================================ -->
        <main class="flex-1 bg-[#101517] overflow-y-auto p-6 sm:p-8">

          <!-- ------------------------------------------------------------- -->
          <!-- PANE 1: DASHBOARD HOME (Overview, Quick Draft, Site Health) -->
          <!-- ------------------------------------------------------------- -->
          <div id="pane-dashboard" class="wp-pane space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
              <h1 class="text-2xl font-bold text-white">Dashboard</h1>
              <span class="text-xs font-mono text-white/50">WordPress 6.6.2 running on Astro static engine</span>
            </div>

            <!-- Welcome Banner -->
            <div class="bg-[#1d2327] border border-white/10 rounded-2xl p-6 relative overflow-hidden">
              <div class="max-w-2xl">
                <h2 class="text-xl font-bold text-white mb-2">Welcome to your site control room, Ratul!</h2>
                <p class="text-xs text-white/60 leading-relaxed mb-5">
                  We've assembled some links to get you started customizing every aspect of your site: write blog articles, change images anywhere, adjust colors and fonts, or manage Meta ads.
                </p>
                <div class="flex flex-wrap items-center gap-3">
                  <button type="button" class="btn-quick-switch bg-[#2271b1] hover:bg-[#135e96] text-white text-xs px-4 py-2 rounded-lg font-medium" data-target="pane-appearance">Open Site Editor &amp; Styles</button>
                  <button type="button" class="btn-quick-switch bg-white/5 hover:bg-white/10 text-white text-xs px-4 py-2 rounded-lg font-medium border border-white/15" data-target="pane-posts">Write a Blog Post</button>
                  <a href={homeUrl} target="_blank" class="text-xs text-wpblue hover:underline py-2">View your site ↗</a>
                </div>
              </div>
            </div>

            <!-- At a Glance & Quick Draft Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              
              <!-- At a Glance -->
              <div class="bg-[#1d2327] border border-white/10 rounded-2xl p-6">
                <h3 class="text-sm font-semibold text-white mb-4 pb-2 border-b border-white/10">At a Glance</h3>
                <div class="grid grid-cols-2 gap-4 text-xs font-mono mb-4">
                  <div class="flex items-center gap-2"><span class="text-peach font-bold" id="dash-stat-posts">5</span> <span>Posts Published</span></div>
                  <div class="flex items-center gap-2"><span class="text-peach font-bold">4</span> <span>Static Pages</span></div>
                  <div class="flex items-center gap-2"><span class="text-mint font-bold" id="dash-stat-media">6</span> <span>Media Assets</span></div>
