---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout
  title="Admin Control Center | iAdvert Studio"
  description="Private administrative management panel for iAdvert Studio. Restricted access."
>
  <Navbar />

  <main class="pt-28 md:pt-36 pb-24 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <!-- ================================================================ -->
      <!-- SECURITY LOCK GATE (Visible when unauthenticated) -->
      <!-- ================================================================ -->
      <div id="admin-auth-gate" class="min-h-[65vh] flex items-center justify-center">
        <div class="liquid-glass rounded-3xl p-8 sm:p-12 max-w-md w-full border border-terra/30 shadow-2xl relative overflow-hidden text-center">
          <!-- Ambient Glow -->
          <div class="absolute -top-20 -left-20 w-44 h-44 bg-terra-bright/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-20 -right-20 w-44 h-44 bg-peach/20 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Lock Icon -->
          <div class="w-16 h-16 rounded-2xl liquid-glass-icon mx-auto flex items-center justify-center text-peach mb-6 shadow-[0_0_25px_rgba(255,218,210,0.2)]">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>

          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full liquid-glass-inner text-[11px] font-mono text-terra-bright uppercase tracking-widest mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-terra-bright animate-ping"></span>
            RESTRICTED ADMIN STUDIO
          </div>

          <h1 class="font-display text-2xl sm:text-3xl font-bold text-white mb-2">
            Control Center <span class="text-peach font-bold italic">ACCESS.</span>
          </h1>

          <p class="text-white/60 text-xs sm:text-sm font-sans mb-8 leading-relaxed">
            This administration gateway is restricted to Ratul Ahmed Shishir. Please enter the studio master security key.
          </p>

          <form id="admin-login-form" class="space-y-4">
            <div class="relative">
              <input
                type="password"
                id="admin-password-input"
                placeholder="Enter Admin Password..."
                class="w-full bg-obsidian-950/80 border border-white/20 rounded-2xl px-4 py-3 pl-11 text-sm text-white placeholder-white/40 font-mono focus:outline-none focus:border-peach"
                autocomplete="current-password"
                required
              />
              <svg class="w-4 h-4 text-white/40 absolute left-4 top-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <button
                type="button"
                id="btn-toggle-pwd"
                class="absolute right-3.5 top-3.5 text-white/40 hover:text-white text-xs font-mono"
              >
                Show
              </button>
            </div>

            <div id="login-error-msg" class="hidden text-xs font-mono text-terra-bright bg-terra/10 border border-terra/30 p-2.5 rounded-xl">
              Invalid security key. Please check and retry.
            </div>

            <button
              type="submit"
              class="w-full bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm py-3.5 rounded-2xl border border-peach/25 shadow-xl shadow-terra/30 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
            >
              <span>Unlock Admin Suite</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-5 border-t border-white/[0.08] text-[11px] font-mono text-white/40">
            Default Master Key: <span class="text-peach select-all">admin@iadvert2027</span>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- MAIN ADMIN CONTROL SUITE (Hidden until authenticated) -->
      <!-- ================================================================ -->
      <div id="admin-main-suite" class="hidden space-y-8 animate-in fade-in duration-300">

        <!-- Top Header & Admin Bar -->
        <section class="pb-6 border-b border-white/[0.08]">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div>
              <div class="flex flex-wrap items-center gap-2.5 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full liquid-glass-inner text-[11px] font-mono text-accent-mint">
                  <span class="w-2 h-2 rounded-full bg-accent-mint animate-pulse shadow-[0_0_8px_rgba(46,213,115,0.8)]"></span>
                  ADMIN SESSION ACTIVE
                </span>
                <span class="text-white/40 text-xs font-mono">•</span>
                <span class="text-white/60 text-xs font-mono">Hidden From Public</span>
                <span class="text-white/40 text-xs font-mono">•</span>
                <span class="text-peach text-xs font-mono">Owner: Ratul Ahmed Shishir</span>
              </div>
              <h1 class="font-display text-3xl sm:text-4xl font-bold text-white tracking-tight">
                Studio Management <span class="text-peach font-bold italic">PANEL.</span>
              </h1>
              <p class="text-white/60 text-xs sm:text-sm mt-1 font-sans max-w-2xl">
                Complete WordPress, Shopify &amp; Wix style studio controller: manage blog articles, edit homepage sections, configure Google SEO, upload media, and monitor ad scale.
              </p>
            </div>

            <!-- Quick Controls & Logout -->
            <div class="flex flex-wrap items-center gap-3">
              <a
                href={homeUrl}
                target="_blank"
                class="liquid-glass-inner hover:bg-white/10 text-white/80 hover:text-white px-4 py-2.5 rounded-2xl text-xs font-mono inline-flex items-center gap-2 transition-all"
              >
                <span>View Public Site</span>
                <svg class="w-3.5 h-3.5 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>

              <button
                type="button"
                id="btn-admin-logout"
                class="bg-terra/10 hover:bg-terra/20 text-terra-bright border border-terra/30 px-4 py-2.5 rounded-2xl text-xs font-mono font-semibold transition-all inline-flex items-center gap-2"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Lock &amp; Logout</span>
              </button>
            </div>
          </div>
        </section>

        <!-- Navigation Tabs (Pill Bar) -->
        <section>
          <div class="liquid-glass p-1.5 rounded-2xl flex items-center gap-1.5 overflow-x-auto no-scrollbar" id="dashboard-nav-tabs">
            <button
              type="button"
              data-tab="blog"
              class="dash-tab active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-white/10 border border-white/15 shadow-sm transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>Blog &amp; Posts (CMS)</span>
              <span class="text-[10px] font-mono bg-peach/20 text-peach px-2 py-0.5 rounded-full" id="badge-post-count">5</span>
            </button>

            <button
              type="button"
              data-tab="customizer"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-terra-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m4.93 4.93 4.24 4.24"></path>
                <path d="m14.83 9.17 4.24-4.24"></path>
                <path d="m14.83 14.83 4.24 4.24"></path>
                <path d="m9.17 14.83-4.24 4.24"></path>
              </svg>
              <span>Site &amp; Page Customizer</span>
            </button>

            <button
              type="button"
              data-tab="seo"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-accent-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>Google SERP &amp; SEO</span>
            </button>

            <button
              type="button"
              data-tab="media"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>Media Library</span>
            </button>

            <button
              type="button"
              data-tab="settings"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-terra-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              <span>Brand Identity</span>
            </button>

            <button
              type="button"
              data-tab="security"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Security &amp; Key</span>
            </button>

            <button
              type="button"
              data-tab="analytics"
              class="dash-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-white/70 hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-accent-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              <span>Ad Performance</span>
            </button>
          </div>
        </section>

        <!-- ================================================================ -->
        <!-- TAB 1: BLOG & POSTS CMS -->
        <!-- ================================================================ -->
        <div id="tab-panel-blog" class="dash-panel space-y-8">
          <div class="liquid-glass rounded-3xl p-5 sm:p-6 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-3">
              <button
                type="button"
                id="btn-create-post"
                class="bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white text-xs sm:text-sm font-semibold tracking-wide uppercase px-5 py-2.5 rounded-xl border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105 inline-flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Write New Article</span>
              </button>

              <div class="liquid-glass-inner px-2 py-1 rounded-xl flex items-center gap-1 text-xs font-mono" id="cms-category-filter">
                <button type="button" data-cat="all" class="cat-filter-btn active px-3 py-1.5 rounded-lg text-white bg-white/10 font-bold border border-white/10">All</button>
                <button type="button" data-cat="Meta Ads" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white">Meta Ads</button>
                <button type="button" data-cat="CAPI" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white">CAPI</button>
                <button type="button" data-cat="Creative" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white">Creative</button>
                <button type="button" data-cat="Strategy" class="cat-filter-btn px-3 py-1.5 rounded-lg text-white/60 hover:text-white">Strategy</button>
              </div>
            </div>

            <div class="flex items-center gap-2.5">
              <div class="relative flex-1 md:w-64">
                <input
                  type="text"
                  id="cms-search-input"
                  placeholder="Search articles & tags..."
                  class="w-full bg-obsidian-950/70 border border-white/10 rounded-xl px-3.5 py-2 pl-9 text-xs font-mono text-white placeholder-white/40 focus:outline-none focus:border-peach"
                />
                <svg class="w-3.5 h-3.5 text-white/40 absolute left-3 top-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>

              <button
                type="button"
                id="btn-export-json"
                title="Export posts as JSON"
                class="liquid-glass-inner hover:bg-white/10 text-white/70 hover:text-white px-3 py-2 rounded-xl text-xs font-mono flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span class="hidden sm:inline">Export</span>
              </button>
            </div>
          </div>

          <!-- Articles Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cms-posts-container">
            <!-- Populated via JavaScript -->
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 2: SITE & PAGE CONTENT CUSTOMIZER (Wix/Shopify Style) -->
        <!-- ================================================================ -->
        <div id="tab-panel-customizer" class="dash-panel hidden space-y-8">
          <div class="liquid-glass rounded-3xl p-6 sm:p-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/[0.08] mb-8">
              <div>
                <h2 class="font-display text-2xl font-bold text-white">Visual Website Customizer</h2>
                <p class="text-white/60 text-xs sm:text-sm font-sans mt-1">Change headlines, trust badges, services, case studies &amp; founder quote across the live website</p>
              </div>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="btn-restore-customizer"
                  class="liquid-glass-inner hover:bg-white/10 text-white/60 hover:text-white px-4 py-2.5 rounded-xl text-xs font-mono"
                >
                  Reset Defaults
                </button>
                <button
                  type="button"
                  id="btn-save-customizer"
                  class="bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white text-xs sm:text-sm font-semibold tracking-wide uppercase px-6 py-2.5 rounded-xl border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105 flex items-center gap-2"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                  </svg>
                  <span>Apply to Live Site</span>
                </button>
              </div>
            </div>

            <form id="site-customizer-form" class="space-y-8">
              
              <!-- Section 1: Hero Banner -->
              <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 space-y-4">
                <h3 class="text-sm font-mono text-peach uppercase tracking-wider flex items-center gap-2">
                  <span>01.</span> Hero Section &amp; Headlines
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="md:col-span-2">
                    <label for="cust-hero-tag" class="block text-xs font-mono text-white/70 mb-1.5">Top Floating Badge</label>
                    <input
                      type="text"
                      id="cust-hero-tag"
                      value="100% SPECIALIZED IN META &amp; FACEBOOK ADS"
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-xs font-mono text-peach"
                    />
                  </div>
                  <div>
                    <label for="cust-hero-headline-1" class="block text-xs font-mono text-white/70 mb-1.5">Main Headline (Line 1)</label>
                    <input
                      type="text"
                      id="cust-hero-headline-1"
                      value="We Scale Brands with"
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-sm text-white"
                    />
                  </div>
                  <div>
                    <label for="cust-hero-headline-2" class="block text-xs font-mono text-white/70 mb-1.5">Highlighted Headline (Terra &amp; Peach)</label>
                    <input
                      type="text"
                      id="cust-hero-headline-2"
                      value="HIGH-PERFORMANCE META ADS."
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-sm text-terra-bright font-bold"
                    />
                  </div>
                  <div class="md:col-span-2">
                    <label for="cust-hero-subtitle" class="block text-xs font-mono text-white/70 mb-1.5">Subtitle Paragraph</label>
                    <textarea
                      id="cust-hero-subtitle"
                      rows="2"
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-xs text-white leading-relaxed"
                    >Stop guessing your Facebook ad spend. Build a profitable sales machine with psychological creative hooks, data-driven CBO architecture, and bulletproof server-side CAPI tracking.</textarea>
                  </div>
                  <div>
                    <label for="cust-hero-cta" class="block text-xs font-mono text-white/70 mb-1.5">Primary CTA Button Text</label>
                    <input
                      type="text"
                      id="cust-hero-cta"
                      value="Get Free 20-Min Audit"
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-xs text-white"
                    />
                  </div>
                  <div>
                    <label for="cust-hero-metrics" class="block text-xs font-mono text-white/70 mb-1.5">Trust Metrics (Spend, ROAS, Accuracy)</label>
                    <div class="grid grid-cols-3 gap-2">
                      <input type="text" id="cust-metric-1" value="$100k+" class="bg-obsidian-950/70 border border-white/15 rounded-xl px-2 py-2 text-xs font-mono text-peach text-center" />
                      <input type="text" id="cust-metric-2" value="3.8x – 6.2x" class="bg-obsidian-950/70 border border-white/15 rounded-xl px-2 py-2 text-xs font-mono text-peach text-center" />
                      <input type="text" id="cust-metric-3" value="99.8%" class="bg-obsidian-950/70 border border-white/15 rounded-xl px-2 py-2 text-xs font-mono text-accent-mint text-center" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Section 2: Founder Section -->
              <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 space-y-4">
                <h3 class="text-sm font-mono text-peach uppercase tracking-wider flex items-center gap-2">
                  <span>02.</span> Founder Profile &amp; Bio
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="cust-founder-name" class="block text-xs font-mono text-white/70 mb-1.5">Managing Director / Founder</label>
                    <input
                      type="text"
                      id="cust-founder-name"
                      value="Ratul Ahmed Shishir"
                      class="w-full bg-obsidian-950/70 border border-white/15 rounded-xl px-4 py-2 text-sm text-white font-semibold"
                    />
                  </div>
                  <div>
                    <label for="cust-founder-tagline" class="block text-xs font-mono text-white/70 mb-1.5">Founder Tagline</label>
                    <input
                      type="text"
                      id="cust-founder-tagline"
                      value="THE STRATEGIST BEHIND THE SYSTEM"
