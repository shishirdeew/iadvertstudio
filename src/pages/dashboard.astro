      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-semibold', 'border', 'border-white/15', 'shadow-sm');
      btn.classList.remove('text-white/70', 'font-medium');

      // Show matching panel
      tabPanels.forEach(panel => {
        if (panel.id === `tab-panel-${tabId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  // ================================================================
