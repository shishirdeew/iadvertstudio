          <textarea id="edit-body" rows="9" class="w-full bg-obsidian-950/90 border border-white/15 rounded-xl px-4 py-3 text-xs sm:text-sm font-mono text-white leading-relaxed"></textarea>
        </div>
      </div>

      <div class="p-6 border-t border-white/[0.08] flex items-center justify-between bg-obsidian-900/60">
        <button type="button" id="btn-download-md" class="liquid-glass-inner text-white/70 hover:text-white px-4 py-2 rounded-xl text-xs font-mono inline-flex items-center gap-1.5">
          <span>Download .MD File</span>
        </button>
        <div class="flex items-center gap-3">
          <button type="button" id="btn-cancel-modal" class="liquid-glass-inner text-white/70 hover:text-white px-5 py-2.5 rounded-xl text-xs font-mono">Cancel</button>
          <button type="button" id="btn-save-post" class="bg-gradient-to-r from-terra-bright to-terra text-white text-xs sm:text-sm font-semibold uppercase px-6 py-2.5 rounded-xl border border-peach/20">Save &amp; Publish</button>
        </div>
      </div>
    </div>
  </div>

  <!-- FLOATING TOAST -->
  <div id="dash-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="liquid-glass border border-peach/40 shadow-2xl rounded-2xl px-5 py-3.5 flex items-center gap-3 text-white text-xs sm:text-sm backdrop-blur-2xl">
      <span class="w-2 h-2 rounded-full bg-accent-mint animate-pulse"></span>
      <span id="toast-message" class="font-medium">Settings saved!</span>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  // ================================================================
  // ADMIN AUTHENTICATION GATE
  // ================================================================
  const DEFAULT_ADMIN_KEY = 'admin@iadvert2027';

  function getStoredAdminKey(): string {
    return localStorage.getItem('iadverts_admin_password') || DEFAULT_ADMIN_KEY;
  }

  function isAdminLoggedIn(): boolean {
    return localStorage.getItem('iadverts_admin_authenticated') === 'true';
  }

  const authGate = document.getElementById('admin-auth-gate');
  const mainSuite = document.getElementById('admin-main-suite');
  const loginForm = document.getElementById('admin-login-form');
  const pwdInput = document.getElementById('admin-password-input') as HTMLInputElement;
  const errorMsg = document.getElementById('login-error-msg');
  const togglePwdBtn = document.getElementById('btn-toggle-pwd');
  const logoutBtn = document.getElementById('btn-admin-logout');

  function checkAuth() {
    if (isAdminLoggedIn()) {
      authGate?.classList.add('hidden');
      mainSuite?.classList.remove('hidden');
    } else {
      authGate?.classList.remove('hidden');
      mainSuite?.classList.add('hidden');
    }
  }

  // Toggle show/hide password
  togglePwdBtn?.addEventListener('click', () => {
    if (pwdInput.type === 'password') {
      pwdInput.type = 'text';
      togglePwdBtn.textContent = 'Hide';
    } else {
      pwdInput.type = 'password';
      togglePwdBtn.textContent = 'Show';
    }
  });

  // Handle Login
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const entered = pwdInput.value.trim();
    const correct = getStoredAdminKey();

    if (entered === correct) {
      localStorage.setItem('iadverts_admin_authenticated', 'true');
      errorMsg?.classList.add('hidden');
      checkAuth();
      showToast('Welcome, Ratul Ahmed Shishir!');
    } else {
      errorMsg?.classList.remove('hidden');
      pwdInput.focus();
    }
  });

  // Handle Logout
  logoutBtn?.addEventListener('click', () => {
    localStorage.removeItem('iadverts_admin_authenticated');
    checkAuth();
    showToast('Session locked and logged out.');
  });

  // Toast
  function showToast(message: string) {
    const toast = document.getElementById('dash-toast');
    const toastMsg = document.getElementById('toast-message');
    if (toast && toastMsg) {
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      }, 3000);
    }
  }

  // ================================================================
  // TAB NAVIGATION
  // ================================================================
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.dash-tab');
  const tabPanels = document.querySelectorAll<HTMLElement>('.dash-panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (!tabId) return;

      tabButtons.forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-white/10', 'font-semibold', 'border', 'border-white/15', 'shadow-sm');
        b.classList.add('text-white/70', 'font-medium');
      });
      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-semibold', 'border', 'border-white/15', 'shadow-sm');
      btn.classList.remove('text-white/70', 'font-medium');

      tabPanels.forEach(panel => {
        if (panel.id === `tab-panel-${tabId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  // ================================================================
  // BLOG POSTS (CMS)
  // ================================================================
  interface BlogPostItem {
    id: string;
    slug: string;
    title: string;
    description: string;
    category: string;
    tags: string;
    readTime: string;
    pubDate: string;
    image: string;
    featured: boolean;
    body: string;
  }

  const DEFAULT_POSTS: BlogPostItem[] = [
    {
      id: 'tripled-roas-beauty',
      slug: 'tripled-roas-beauty',
      title: 'How We Tripled ROAS for a D2C Beauty Brand in 45 Days',
      description: 'Using AI UGC creative and cloud CAPI integration, we recovered 28% drop-off and turned casual browsers into repeat customers — cutting CPA by 44%.',
      category: 'Meta Ads',
      tags: 'Meta Ads, UGC, Scaling, Beauty',
      readTime: '8 min read',
      pubDate: '2026-11-15',
      image: '/assets/hero-3d-concept.jpg',
      featured: true,
      body: `## The Challenge\n\nA fast-growing D2C beauty brand was struggling with diminishing returns on their Meta ad spend...`
    },
    {
      id: 'capi-setup-checklist',
      slug: 'capi-setup-checklist',
      title: 'The Complete CAPI Setup Checklist for 2027',
      description: 'A step-by-step walkthrough of the Conversions API implementation that protects your ad data against iOS changes and ensures accurate attribution.',
      category: 'CAPI',
      tags: 'CAPI, Tracking, Stape.io, Meta Events',
      readTime: '12 min read',
      pubDate: '2026-10-22',
      image: '/assets/hero-3d-concept.jpg',
      featured: false,
      body: `## Why Browser Pixels Are Failing\n\nThird-party cookie depreciation and browser ad-blockers strip away 15% to 35% of tracking signals...`
    },
    {
      id: 'creative-psychology-ads',
      slug: 'creative-psychology-ads',
      title: 'Creative Psychology: Designing Ads That Stick',
      description: 'From color psychology to hook placement, we break down the exact visual elements that make Meta ads impossible to scroll past.',
      category: 'Creative',
      tags: 'Creative, Psychology, Hook Rate, Copywriting',
      readTime: '6 min read',
      pubDate: '2026-09-30',
      image: '/assets/hero-3d-concept.jpg',
      featured: false,
      body: `## The 3-Second War for Attention\n\nYour ad does not compete with other brands — it competes with close friends and algorithmic dopamine feeds...`
    },
    {
      id: 'scaling-playbook',
      slug: 'scaling-playbook',
      title: 'From $2K to $20K Monthly Ad Spend: A Scaling Playbook',
      description: 'The systematic framework we use to scale ad budgets 10x without losing ROAS — including bid strategies and audience layering.',
      category: 'Strategy',
      tags: 'Scaling, CBO, Budget Allocation, ROAS',
      readTime: '10 min read',
      pubDate: '2026-09-05',
      image: '/assets/hero-3d-concept.jpg',
      featured: false,
      body: `## The Plateau Problem\n\nMost media buyers scale vertically by increasing ad set budget by 50% in one click, resetting algorithmic learning...`
    },
    {
      id: 'meta-mistakes',
      slug: 'meta-mistakes',
      title: '5 Common Meta Ad Mistakes and How to Fix Them',
      description: 'From wrong attribution windows to creative fatigue, we cover the most frequent errors that drain ad budgets — and the quick fixes.',
      category: 'Education',
      tags: 'Mistakes, Learning Phase, Audience Overlap',
      readTime: '5 min read',
      pubDate: '2026-08-20',
      image: '/assets/hero-3d-concept.jpg',
      featured: false,
      body: `## Common Pitfalls\n\n1. Turning off ads too early during 50-conversion learning phase...`
    }
  ];

  function getStoredPosts(): BlogPostItem[] {
    const raw = localStorage.getItem('iadverts_cms_posts');
    if (!raw) {
      localStorage.setItem('iadverts_cms_posts', JSON.stringify(DEFAULT_POSTS));
      return DEFAULT_POSTS;
    }
    try { return JSON.parse(raw); } catch { return DEFAULT_POSTS; }
  }

  function saveStoredPosts(posts: BlogPostItem[]) {
    localStorage.setItem('iadverts_cms_posts', JSON.stringify(posts));
  }

  function renderPosts() {
    const container = document.getElementById('cms-posts-container');
    const badgeCount = document.getElementById('badge-post-count');
    if (!container) return;

    const posts = getStoredPosts();
    if (badgeCount) badgeCount.textContent = posts.length.toString();

    container.innerHTML = posts.map(post => `
      <div class="liquid-glass rounded-3xl overflow-hidden flex flex-col group border border-white/10 hover:border-peach/30 transition-all">
        <div class="relative h-44 overflow-hidden bg-obsidian-950">
          <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950/80 via-transparent to-transparent"></div>
          <span class="absolute top-3 left-3 text-[10px] font-mono uppercase tracking-widest text-peach bg-obsidian-950/80 px-2.5 py-1 rounded-full border border-white/10">${post.category}</span>
          ${post.featured ? '<span class="absolute top-3 right-3 text-[10px] font-mono text-white bg-terra/80 px-2 py-0.5 rounded-full border border-peach/30">Featured</span>' : ''}
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h4 class="font-display text-base font-bold text-white mb-2 line-clamp-2">${post.title}</h4>
          <p class="text-white/60 text-xs line-clamp-2 mb-3 font-sans">${post.description}</p>
          <div class="text-[10px] font-mono text-peach/70 mb-4 truncate">${post.tags || '#MetaAds'}</div>
          <div class="mt-auto pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
            <button type="button" data-edit-post="${post.slug}" class="text-peach hover:underline flex items-center gap-1">Edit</button>
            <button type="button" data-download-post="${post.slug}" class="text-white/50 hover:text-white">Download .md</button>
            <button type="button" data-delete-post="${post.slug}" class="text-terra-bright/60 hover:text-terra-bright">Delete</button>
          </div>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('[data-edit-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-edit-post');
        if (slug) openEditorModal(slug);
      });
    });

    container.querySelectorAll('[data-download-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-download-post');
        if (slug) downloadMarkdown(slug);
      });
    });

    container.querySelectorAll('[data-delete-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-delete-post');
        if (slug && confirm('Delete this post?')) {
          const filtered = getStoredPosts().filter(p => p.slug !== slug);
          saveStoredPosts(filtered);
          renderPosts();
          showToast('Article deleted.');
        }
      });
    });
  }

  // Post Editor Modal
  const editorModal = document.getElementById('modal-post-editor');
  const editPostId = document.getElementById('edit-post-id') as HTMLInputElement;
  const editTitle = document.getElementById('edit-title') as HTMLInputElement;
  const editSlug = document.getElementById('edit-slug') as HTMLInputElement;
  const editCategory = document.getElementById('edit-category') as HTMLSelectElement;
  const editTags = document.getElementById('edit-tags') as HTMLInputElement;
  const editReadTime = document.getElementById('edit-readtime') as HTMLInputElement;
  const editFeatured = document.getElementById('edit-featured') as HTMLInputElement;
  const editCoverUrl = document.getElementById('edit-cover-url') as HTMLInputElement;
  const editCoverPreview = document.getElementById('edit-cover-preview') as HTMLImageElement;
  const editExcerpt = document.getElementById('edit-excerpt') as HTMLTextAreaElement;
  const editBody = document.getElementById('edit-body') as HTMLTextAreaElement;

  function openEditorModal(slugToEdit?: string) {
    if (slugToEdit) {
      const p = getStoredPosts().find(post => post.slug === slugToEdit);
      if (p) {
        editPostId.value = p.id;
        editTitle.value = p.title;
        editSlug.value = p.slug;
        editCategory.value = p.category;
        editTags.value = p.tags || '';
        editReadTime.value = p.readTime;
        editFeatured.checked = p.featured;
        editCoverUrl.value = p.image;
        editCoverPreview.src = p.image;
        editExcerpt.value = p.description;
        editBody.value = p.body;
      }
    } else {
      editPostId.value = '';
      editTitle.value = '';
      editSlug.value = '';
      editCategory.value = 'Meta Ads';
      editTags.value = 'Meta Ads, Scaling, CAPI';
      editReadTime.value = '6 min read';
      editFeatured.checked = false;
      editCoverUrl.value = '/assets/hero-3d-concept.jpg';
      editCoverPreview.src = '/assets/hero-3d-concept.jpg';
      editExcerpt.value = '';
      editBody.value = '## The Strategy\n\nWrite content here...';
    }
    editorModal?.classList.remove('hidden');
  }

  document.getElementById('btn-create-post')?.addEventListener('click', () => openEditorModal());
  document.getElementById('btn-close-editor-modal')?.addEventListener('click', () => editorModal?.classList.add('hidden'));
  document.getElementById('btn-cancel-modal')?.addEventListener('click', () => editorModal?.classList.add('hidden'));

  editCoverUrl?.addEventListener('input', () => { editCoverPreview.src = editCoverUrl.value; });
  document.getElementById('edit-cover-file')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const r = new FileReader();
      r.onload = (ev) => {
        const b64 = ev.target?.result as string;
        editCoverUrl.value = b64;
        editCoverPreview.src = b64;
      };
      r.readAsDataURL(file);
    }
  });

  document.getElementById('btn-save-post')?.addEventListener('click', () => {
    if (!editTitle.value.trim()) return alert('Please enter a title.');
    const slug = editSlug.value.trim() || editTitle.value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const posts = getStoredPosts();
    const idx = posts.findIndex(p => p.slug === slug || (editPostId.value && p.id === editPostId.value));

    const item: BlogPostItem = {
      id: editPostId.value || slug,
      slug: slug,
      title: editTitle.value.trim(),
      description: editExcerpt.value.trim(),
      category: editCategory.value,
      tags: editTags.value.trim(),
      readTime: editReadTime.value.trim(),
      pubDate: new Date().toISOString().split('T')[0],
      image: editCoverUrl.value.trim() || '/assets/hero-3d-concept.jpg',
      featured: editFeatured.checked,
      body: editBody.value.trim()
    };

    if (idx >= 0) posts[idx] = item;
    else posts.unshift(item);

    saveStoredPosts(posts);
    renderPosts();
    editorModal?.classList.add('hidden');
    showToast('Article saved & published!');
  });

  function downloadMarkdown(slug: string) {
    const p = getStoredPosts().find(post => post.slug === slug);
    if (!p) return;
    const content = `---\ntitle: '${p.title.replace(/'/g, "''")}'\ndescription: '${p.description.replace(/'/g, "''")}'\npubDate: ${p.pubDate}\ncategory: '${p.category}'\nreadTime: '${p.readTime}'\nimage: '${p.image}'\nfeatured: ${p.featured}\n---\n\n${p.body}\n`;
    const blob = new Blob([content], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${p.slug}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`Downloaded ${p.slug}.md!`);
  }

  // ================================================================
  // SITE CONTENT CUSTOMIZER (Wix/Shopify Style)
  // ================================================================
  interface SiteContentConfig {
    heroTag: string;
    heroHeadline1: string;
    heroHeadline2: string;
    heroSubtitle: string;
    heroCta: string;
    metric1: string;
    metric2: string;
    metric3: string;
    founderName: string;
    founderTagline: string;
    founderQuote: string;
    ctaHeadline: string;
    ctaBtn: string;
    ctaFeatures: string;
  }

  const DEFAULT_SITE_CONTENT: SiteContentConfig = {
    heroTag: '100% SPECIALIZED IN META & FACEBOOK ADS',
    heroHeadline1: 'We Scale Brands with',
    heroHeadline2: 'HIGH-PERFORMANCE META ADS.',
    heroSubtitle: 'Stop guessing your Facebook ad spend. Build a profitable sales machine with psychological creative hooks, data-driven CBO architecture, and bulletproof server-side CAPI tracking.',
    heroCta: 'Get Free 20-Min Audit',
    metric1: '$100k+',
    metric2: '3.8x – 6.2x',
    metric3: '99.8%',
    founderName: 'Ratul Ahmed Shishir',
    founderTagline: 'THE STRATEGIST BEHIND THE SYSTEM',
    founderQuote: '"Agencies that claim to handle graphics, logos, websites, and SEO all at once cannot truly specialize in any. I have spent the last several years focusing exclusively on the internal algorithms, high-conversion copywriting, and server-side tracking mechanisms of Meta and Facebook ads. My single goal: to deliver the maximum cash return for every 1 taka of ad spend."',
    ctaHeadline: 'Ready to Build a Predictable REVENUE ENGINE WITH META ADS?',
    ctaBtn: 'Book 20-Min Strategy Audit on WhatsApp',
    ctaFeatures: '✓ Free 1-on-1 Consultation • ✓ Actionable Scaling Roadmap • ✓ Zero Obligation'
  };

  function loadCustomizer() {
    const raw = localStorage.getItem('iadverts_custom_site_content');
    const c: SiteContentConfig = raw ? JSON.parse(raw) : DEFAULT_SITE_CONTENT;

    (document.getElementById('cust-hero-tag') as HTMLInputElement).value = c.heroTag;
    (document.getElementById('cust-hero-headline-1') as HTMLInputElement).value = c.heroHeadline1;
    (document.getElementById('cust-hero-headline-2') as HTMLInputElement).value = c.heroHeadline2;
    (document.getElementById('cust-hero-subtitle') as HTMLTextAreaElement).value = c.heroSubtitle;
    (document.getElementById('cust-hero-cta') as HTMLInputElement).value = c.heroCta;
    (document.getElementById('cust-metric-1') as HTMLInputElement).value = c.metric1;
    (document.getElementById('cust-metric-2') as HTMLInputElement).value = c.metric2;
    (document.getElementById('cust-metric-3') as HTMLInputElement).value = c.metric3;
    (document.getElementById('cust-founder-name') as HTMLInputElement).value = c.founderName;
    (document.getElementById('cust-founder-tagline') as HTMLInputElement).value = c.founderTagline;
    (document.getElementById('cust-founder-quote') as HTMLTextAreaElement).value = c.founderQuote;
    (document.getElementById('cust-cta-headline') as HTMLInputElement).value = c.ctaHeadline;
    (document.getElementById('cust-cta-btn') as HTMLInputElement).value = c.ctaBtn;
    (document.getElementById('cust-cta-features') as HTMLInputElement).value = c.ctaFeatures;
  }

  document.getElementById('btn-save-customizer')?.addEventListener('click', () => {
    const c: SiteContentConfig = {
      heroTag: (document.getElementById('cust-hero-tag') as HTMLInputElement).value.trim(),
      heroHeadline1: (document.getElementById('cust-hero-headline-1') as HTMLInputElement).value.trim(),
      heroHeadline2: (document.getElementById('cust-hero-headline-2') as HTMLInputElement).value.trim(),
      heroSubtitle: (document.getElementById('cust-hero-subtitle') as HTMLTextAreaElement).value.trim(),
      heroCta: (document.getElementById('cust-hero-cta') as HTMLInputElement).value.trim(),
      metric1: (document.getElementById('cust-metric-1') as HTMLInputElement).value.trim(),
      metric2: (document.getElementById('cust-metric-2') as HTMLInputElement).value.trim(),
      metric3: (document.getElementById('cust-metric-3') as HTMLInputElement).value.trim(),
      founderName: (document.getElementById('cust-founder-name') as HTMLInputElement).value.trim(),
      founderTagline: (document.getElementById('cust-founder-tagline') as HTMLInputElement).value.trim(),
      founderQuote: (document.getElementById('cust-founder-quote') as HTMLTextAreaElement).value.trim(),
      ctaHeadline: (document.getElementById('cust-cta-headline') as HTMLInputElement).value.trim(),
      ctaBtn: (document.getElementById('cust-cta-btn') as HTMLInputElement).value.trim(),
      ctaFeatures: (document.getElementById('cust-cta-features') as HTMLInputElement).value.trim(),
    };
    localStorage.setItem('iadverts_custom_site_content', JSON.stringify(c));
    showToast('Website content updated! Live on homepage.');
  });

  document.getElementById('btn-restore-customizer')?.addEventListener('click', () => {
    if (confirm('Reset homepage content to defaults?')) {
      localStorage.setItem('iadverts_custom_site_content', JSON.stringify(DEFAULT_SITE_CONTENT));
      loadCustomizer();
      showToast('Website content reset to factory defaults.');
    }
  });

  // ================================================================
  // SECURITY & MASTER PASSWORD
  // ================================================================
  document.getElementById('btn-update-password')?.addEventListener('click', () => {
    const newPwd = (document.getElementById('new-admin-password') as HTMLInputElement).value.trim();
    if (!newPwd || newPwd.length < 6) {
      alert('Password must be at least 6 characters.');
      return;
    }
    localStorage.setItem('iadverts_admin_password', newPwd);
    (document.getElementById('new-admin-password') as HTMLInputElement).value = '';
    showToast('Master Password updated successfully!');
  });

  document.getElementById('btn-reset-default-pwd')?.addEventListener('click', () => {
    if (confirm(`Reset master password to "${DEFAULT_ADMIN_KEY}"?`)) {
      localStorage.setItem('iadverts_admin_password', DEFAULT_ADMIN_KEY);
      showToast('Password reset to admin@iadvert2027.');
    }
  });

  // Secret shortcut: Ctrl + Shift + A to open admin
  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'a') {
      window.location.href = '/dashboard';
    }
  });

  // Initial Boot
  checkAuth();
  renderPosts();
  loadCustomizer();
</script>
