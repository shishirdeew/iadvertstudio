    <!-- ================================================================ -->
    <!-- SCRIPT LOGIC -->
    <!-- ================================================================ -->
    <script>
      // 1. AUTHENTICATION
      const MASTER_KEY_DEFAULT = 'admin@iadvert2027';
      function getMasterKey() {
        return localStorage.getItem('iadverts_admin_password') || MASTER_KEY_DEFAULT;
      }
      function isAuthed() {
        return localStorage.getItem('iadverts_admin_authenticated') === 'true';
      }
      const authGate = document.getElementById('wp-auth-gate');
      const appContainer = document.getElementById('wp-app-container');
      const loginForm = document.getElementById('wp-login-form');
      const loginPwd = document.getElementById('wp-login-pwd') as HTMLInputElement;
      const loginErr = document.getElementById('wp-login-error');
      const logoutBtn = document.getElementById('btn-wp-logout');

      function refreshAuth() {
        if (isAuthed()) {
          authGate?.classList.add('hidden');
          appContainer?.classList.remove('hidden');
          appContainer?.classList.add('flex');
        } else {
          authGate?.classList.remove('hidden');
          appContainer?.classList.add('hidden');
          appContainer?.classList.remove('flex');
        }
      }

      loginForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (loginPwd.value.trim() === getMasterKey()) {
          localStorage.setItem('iadverts_admin_authenticated', 'true');
          loginErr?.classList.add('hidden');
          refreshAuth();
          toast('Welcome to WordPress 6.6 Admin!');
        } else {
          loginErr?.classList.remove('hidden');
          loginPwd.focus();
        }
      });

      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem('iadverts_admin_authenticated');
        refreshAuth();
      });

      function toast(msg: string) {
        const t = document.getElementById('wp-toast');
        if (t) {
          t.textContent = msg;
          t.classList.remove('opacity-0', 'pointer-events-none');
          setTimeout(() => t.classList.add('opacity-0', 'pointer-events-none'), 2800);
        }
      }

      // 2. SIDEBAR NAVIGATION
      const menuBtns = document.querySelectorAll('.wp-menu-btn');
      const panes = document.querySelectorAll('.wp-pane');

      function switchPane(targetId: string) {
        panes.forEach(p => {
          if (p.id === targetId) p.classList.remove('hidden');
          else p.classList.add('hidden');
        });
        menuBtns.forEach(b => {
          if (b.getAttribute('data-pane') === targetId) {
            b.classList.add('bg-[#2271b1]', 'text-white');
            b.classList.remove('text-[#c3c4c7]', 'hover:bg-[#13171a]');
          } else {
            b.classList.remove('bg-[#2271b1]', 'text-white');
            b.classList.add('text-[#c3c4c7]', 'hover:bg-[#13171a]');
          }
        });
      }

      menuBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-pane');
          if (target) switchPane(target);
        });
      });

      document.querySelectorAll('.btn-quick-switch').forEach(btn => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-target');
          if (t) switchPane(t);
        });
      });

      // 3. POSTS MANAGEMENT (WordPress Posts)
      const DEFAULT_POSTS = [
        { id: 'tripled-roas-beauty', slug: 'tripled-roas-beauty', title: 'How We Tripled ROAS for a D2C Beauty Brand in 45 Days', category: 'Meta Ads', tags: 'Meta Ads, Scaling', pubDate: '2026-11-15', image: '/assets/hero-3d-concept.jpg', excerpt: 'Using AI UGC creative and cloud CAPI...', body: '## The Challenge\n\nFull case details...' },
        { id: 'capi-setup-checklist', slug: 'capi-setup-checklist', title: 'The Complete CAPI Setup Checklist for 2027', category: 'CAPI', tags: 'CAPI, Tracking', pubDate: '2026-10-22', image: '/assets/hero-3d-concept.jpg', excerpt: 'A step-by-step walkthrough of CAPI...', body: '## Implementation...' },
        { id: 'creative-psychology-ads', slug: 'creative-psychology-ads', title: 'Creative Psychology: Designing Ads That Stick', category: 'Creative', tags: 'Creative, Hooks', pubDate: '2026-09-30', image: '/assets/hero-3d-concept.jpg', excerpt: 'From color psychology to hook placement...', body: '## The 3-Second War...' },
        { id: 'scaling-playbook', slug: 'scaling-playbook', title: 'From $2K to $20K Monthly Ad Spend: A Scaling Playbook', category: 'Strategy', tags: 'Scaling, CBO', pubDate: '2026-09-05', image: '/assets/hero-3d-concept.jpg', excerpt: 'The systematic framework we use...', body: '## The Scaling Formula...' },
        { id: 'meta-mistakes', slug: 'meta-mistakes', title: '5 Common Meta Ad Mistakes and How to Fix Them', category: 'Education', tags: 'Mistakes, Learning', pubDate: '2026-08-20', image: '/assets/hero-3d-concept.jpg', excerpt: 'From wrong attribution windows to creative fatigue...', body: '## Pitfalls...' }
      ];

      function getPosts() {
        const raw = localStorage.getItem('iadverts_cms_posts');
        if (!raw) {
          localStorage.setItem('iadverts_cms_posts', JSON.stringify(DEFAULT_POSTS));
          return DEFAULT_POSTS;
        }
        try { return JSON.parse(raw); } catch { return DEFAULT_POSTS; }
      }
      function savePosts(p: any) {
        localStorage.setItem('iadverts_cms_posts', JSON.stringify(p));
      }

      function renderPostsTable() {
        const tbody = document.getElementById('wp-posts-tbody');
        const countDisplay = document.getElementById('posts-count-display');
        const sidebarCount = document.getElementById('wp-sidebar-post-count');
        const dashStat = document.getElementById('dash-stat-posts');
        if (!tbody) return;

        const posts = getPosts();
        if (countDisplay) countDisplay.textContent = posts.length.toString();
        if (sidebarCount) sidebarCount.textContent = posts.length.toString();
        if (dashStat) dashStat.textContent = posts.length.toString();

        tbody.innerHTML = posts.map((post: any) => `
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-2.5 px-4"><img src="${post.image}" class="w-10 h-7 object-cover rounded border border-white/20" /></td>
            <td class="py-2.5 px-4 font-semibold text-white">${post.title}</td>
            <td class="py-2.5 px-4 text-white/70">Ratul Ahmed Shishir</td>
            <td class="py-2.5 px-4 font-mono text-peach">${post.category}</td>
            <td class="py-2.5 px-4 font-mono text-white/50 text-[11px]">${post.tags || 'Meta Ads'}</td>
            <td class="py-2.5 px-4 font-mono text-white/40">${post.pubDate}</td>
            <td class="py-2.5 px-4 text-right space-x-2 font-mono text-[11px]">
              <button type="button" data-edit-post="${post.slug}" class="text-wpblue hover:underline">Edit</button>
              <button type="button" data-del-post="${post.slug}" class="text-red-400 hover:underline">Trash</button>
              <a href="/blog/${post.slug}" target="_blank" class="text-white/40 hover:text-white">View</a>
            </td>
          </tr>
        `).join('');

        tbody.querySelectorAll('[data-edit-post]').forEach(b => {
          b.addEventListener('click', () => {
            const slug = b.getAttribute('data-edit-post');
            if (slug) openEditor(slug);
          });
        });

        tbody.querySelectorAll('[data-del-post]').forEach(b => {
          b.addEventListener('click', () => {
            const slug = b.getAttribute('data-del-post');
            if (slug && confirm('Move this post to Trash?')) {
              const updated = getPosts().filter((p: any) => p.slug !== slug);
              savePosts(updated);
              renderPostsTable();
              toast('Post moved to Trash.');
            }
          });
        });
      }

      // Post Editor Modal
      const postModal = document.getElementById('wp-modal-post-editor');
      const editHeading = document.getElementById('wp-editor-heading');
      const editId = document.getElementById('wp-edit-id') as HTMLInputElement;
      const editTitle = document.getElementById('wp-edit-title') as HTMLInputElement;
      const editSlug = document.getElementById('wp-edit-slug') as HTMLInputElement;
      const editCat = document.getElementById('wp-edit-category') as HTMLSelectElement;
      const editTags = document.getElementById('wp-edit-tags') as HTMLInputElement;
      const editCoverUrl = document.getElementById('wp-edit-cover-url') as HTMLInputElement;
      const editCoverPreview = document.getElementById('wp-edit-cover-preview') as HTMLImageElement;
      const editExcerpt = document.getElementById('wp-edit-excerpt') as HTMLTextAreaElement;
      const editBody = document.getElementById('wp-edit-body') as HTMLTextAreaElement;

      function openEditor(slug?: string) {
        if (!postModal) return;
        if (slug) {
          const p = getPosts().find((post: any) => post.slug === slug);
          if (p) {
            editHeading!.textContent = 'Edit Post';
            editId.value = p.id;
            editTitle.value = p.title;
            editSlug.value = p.slug;
            editCat.value = p.category;
            editTags.value = p.tags || '';
            editCoverUrl.value = p.image;
            editCoverPreview.src = p.image;
            editExcerpt.value = p.excerpt || '';
            editBody.value = p.body || '';
          }
        } else {
          editHeading!.textContent = 'Add New Post';
          editId.value = '';
          editTitle.value = '';
          editSlug.value = '';
          editCat.value = 'Meta Ads';
          editTags.value = 'Meta Ads, Scaling';
          editCoverUrl.value = '/assets/hero-3d-concept.jpg';
          editCoverPreview.src = '/assets/hero-3d-concept.jpg';
          editExcerpt.value = '';
          editBody.value = '## Summary\n\nWrite article here...';
        }
        postModal.classList.remove('hidden');
      }

      document.getElementById('btn-add-new-post')?.addEventListener('click', () => openEditor());
      document.getElementById('wp-top-btn-new')?.addEventListener('click', () => openEditor());
      document.getElementById('btn-close-post-modal')?.addEventListener('click', () => postModal?.classList.add('hidden'));
      document.getElementById('btn-wp-cancel-post')?.addEventListener('click', () => postModal?.classList.add('hidden'));

      editCoverUrl?.addEventListener('input', () => { editCoverPreview.src = editCoverUrl.value; });
      document.getElementById('wp-edit-cover-file')?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) {
          const r = new FileReader();
          r.onload = (ev) => {
            const b64 = ev.target?.result as string;
            editCoverUrl.value = b64;
            editCoverPreview.src = b64;
          };
          r.readAsDataURL(file);
        }
      });

      document.getElementById('btn-wp-save-post')?.addEventListener('click', () => {
        if (!editTitle.value.trim()) return alert('Please enter a title.');
        const slug = editSlug.value.trim() || editTitle.value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        const posts = getPosts();
        const idx = posts.findIndex((p: any) => p.slug === slug || (editId.value && p.id === editId.value));
        const item = {
          id: editId.value || slug,
          slug: slug,
          title: editTitle.value.trim(),
          category: editCat.value,
          tags: editTags.value.trim(),
          image: editCoverUrl.value.trim() || '/assets/hero-3d-concept.jpg',
          excerpt: editExcerpt.value.trim(),
          body: editBody.value.trim(),
          pubDate: new Date().toISOString().split('T')[0]
        };
        if (idx >= 0) posts[idx] = item;
        else posts.unshift(item);
        savePosts(posts);
        renderPostsTable();
        postModal?.classList.add('hidden');
        toast('Post published successfully!');
      });

      // 4. APPEARANCE & GLOBAL STYLES (Colors & Fonts)
      interface GlobalStyles {
        terraColor: string;
        peachColor: string;
        mintColor: string;
        bgColor: string;
        headingFont: string;
        bodyFont: string;
      }

      const DEFAULT_STYLES: GlobalStyles = {
        terraColor: '#e04832',
        peachColor: '#ffdad2',
        mintColor: '#2ed573',
        bgColor: '#0c0a10',
        headingFont: 'Lora',
        bodyFont: 'Plus Jakarta Sans'
      };

      function getStyles(): GlobalStyles {
        const raw = localStorage.getItem('wp_global_styles');
        if (!raw) return DEFAULT_STYLES;
        try { return JSON.parse(raw); } catch { return DEFAULT_STYLES; }
      }

      function applyStylesToUI() {
        const s = getStyles();
        (document.getElementById('style-color-terra') as HTMLInputElement).value = s.terraColor;
        (document.getElementById('style-hex-terra') as HTMLInputElement).value = s.terraColor;
        (document.getElementById('style-color-peach') as HTMLInputElement).value = s.peachColor;
        (document.getElementById('style-hex-peach') as HTMLInputElement).value = s.peachColor;
        (document.getElementById('style-color-mint') as HTMLInputElement).value = s.mintColor;
        (document.getElementById('style-hex-mint') as HTMLInputElement).value = s.mintColor;
        (document.getElementById('style-color-bg') as HTMLInputElement).value = s.bgColor;
        (document.getElementById('style-hex-bg') as HTMLInputElement).value = s.bgColor;
        (document.getElementById('style-font-heading') as HTMLSelectElement).value = s.headingFont;
        (document.getElementById('style-font-body') as HTMLSelectElement).value = s.bodyFont;

        // Preview box
        const prevHeading = document.getElementById('preview-heading');
        const prevBody = document.getElementById('preview-body');
        if (prevHeading) {
          prevHeading.style.fontFamily = s.headingFont;
        }
        if (prevBody) {
          prevBody.style.fontFamily = s.bodyFont;
        }
      }

      // Sync color pickers & hex inputs
      ['terra', 'peach', 'mint', 'bg'].forEach(c => {
        const picker = document.getElementById(`style-color-${c}`) as HTMLInputElement;
        const hex = document.getElementById(`style-hex-${c}`) as HTMLInputElement;
        picker?.addEventListener('input', () => {
          hex.value = picker.value;
          saveAndApplyCurrentStyles();
        });
        hex?.addEventListener('input', () => {
          if (hex.value.startsWith('#') && hex.value.length === 7) {
            picker.value = hex.value;
            saveAndApplyCurrentStyles();
          }
        });
      });

      document.getElementById('style-font-heading')?.addEventListener('change', () => saveAndApplyCurrentStyles());
      document.getElementById('style-font-body')?.addEventListener('change', () => saveAndApplyCurrentStyles());

      // Presets
      document.querySelectorAll('.btn-color-preset').forEach(btn => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-terra') || '#e04832';
          const p = btn.getAttribute('data-peach') || '#ffdad2';
          const bg = btn.getAttribute('data-bg') || '#0c0a10';
          (document.getElementById('style-color-terra') as HTMLInputElement).value = t;
          (document.getElementById('style-hex-terra') as HTMLInputElement).value = t;
          (document.getElementById('style-color-peach') as HTMLInputElement).value = p;
          (document.getElementById('style-hex-peach') as HTMLInputElement).value = p;
          (document.getElementById('style-color-bg') as HTMLInputElement).value = bg;
          (document.getElementById('style-hex-bg') as HTMLInputElement).value = bg;
          saveAndApplyCurrentStyles();
          toast('Color preset applied!');
        });
      });

      function saveAndApplyCurrentStyles() {
        const s: GlobalStyles = {
          terraColor: (document.getElementById('style-hex-terra') as HTMLInputElement).value.trim(),
          peachColor: (document.getElementById('style-hex-peach') as HTMLInputElement).value.trim(),
          mintColor: (document.getElementById('style-hex-mint') as HTMLInputElement).value.trim(),
          bgColor: (document.getElementById('style-hex-bg') as HTMLInputElement).value.trim(),
          headingFont: (document.getElementById('style-font-heading') as HTMLSelectElement).value,
          bodyFont: (document.getElementById('style-font-body') as HTMLSelectElement).value
        };
        localStorage.setItem('wp_global_styles', JSON.stringify(s));
        applyStylesToUI();
      }

      document.getElementById('btn-reset-styles')?.addEventListener('click', () => {
        if (confirm('Reset styles to original defaults?')) {
          localStorage.setItem('wp_global_styles', JSON.stringify(DEFAULT_STYLES));
          applyStylesToUI();
          toast('Styles reset to defaults.');
        }
      });

      // 5. APPEARANCE SUB-TABS
      document.querySelectorAll('.subtab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.subtab-btn').forEach(b => {
            b.classList.remove('active', 'bg-[#2271b1]', 'text-white');
            b.classList.add('text-white/70');
          });
          btn.classList.add('active', 'bg-[#2271b1]', 'text-white');
          btn.classList.remove('text-white/70');

          const sub = btn.getAttribute('data-sub');
          document.querySelectorAll('.subtab-panel').forEach(p => {
            if (p.id === sub) p.classList.remove('hidden');
            else p.classList.add('hidden');
          });
        });
      });

      // 6. PATTERNS & SECTION REORDERING (Drag & Drop + Up/Down)
      const DEFAULT_SECTIONS = [
        { id: 'hero', name: 'Hero Banner Section' },
        { id: 'marquee', name: 'Marquee Client Proof Ticker' },
        { id: 'services', name: 'The 4-Pillar Meta System (Bento Grid)' },
        { id: 'calculator', name: 'ROAS Simulator & Scaler' },
        { id: 'results', name: 'Documented Case Studies' },
        { id: 'founder', name: 'Founder Profile & Bio' },
        { id: 'cta', name: 'Final Revenue Engine CTA' }
      ];

      function getSectionOrder(): string[] {
        const raw = localStorage.getItem('wp_section_order');
        if (!raw) return DEFAULT_SECTIONS.map(s => s.id);
        try { return JSON.parse(raw); } catch { return DEFAULT_SECTIONS.map(s => s.id); }
      }

      function renderSectionsList() {
        const container = document.getElementById('wp-sections-order-list');
        if (!container) return;
        const order = getSectionOrder();

        container.innerHTML = order.map((id, idx) => {
          const match = DEFAULT_SECTIONS.find(s => s.id === id) || { id, name: id };
          return `
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#101517] border border-white/10 hover:border-wpblue/50 transition-colors">
              <div class="flex items-center gap-3">
                <span class="text-white/40 font-mono text-[11px] w-5">${idx + 1}.</span>
                <span class="font-semibold text-white font-sans text-xs">${match.name}</span>
                <span class="text-[10px] text-peach font-mono bg-peach/10 px-2 py-0.5 rounded">#sec-${id}</span>
              </div>
              <div class="flex items-center gap-1">
                <button type="button" data-move-up="${id}" class="p-1 rounded bg-white/5 hover:bg-white/10 text-white/80 hover:text-white" title="Move Up">↑</button>
                <button type="button" data-move-down="${id}" class="p-1 rounded bg-white/5 hover:bg-white/10 text-white/80 hover:text-white" title="Move Down">↓</button>
              </div>
            </div>
          `;
        }).join('');

        container.querySelectorAll('[data-move-up]').forEach(b => {
          b.addEventListener('click', () => {
            const id = b.getAttribute('data-move-up');
            const current = getSectionOrder();
            const idx = current.indexOf(id!);
            if (idx > 0) {
              const temp = current[idx - 1];
              current[idx - 1] = current[idx];
              current[idx] = temp;
              localStorage.setItem('wp_section_order', JSON.stringify(current));
              renderSectionsList();
              toast('Section moved up!');
            }
          });
        });

        container.querySelectorAll('[data-move-down]').forEach(b => {
          b.addEventListener('click', () => {
            const id = b.getAttribute('data-move-down');
            const current = getSectionOrder();
            const idx = current.indexOf(id!);
            if (idx < current.length - 1 && idx >= 0) {
              const temp = current[idx + 1];
              current[idx + 1] = current[idx];
              current[idx] = temp;
              localStorage.setItem('wp_section_order', JSON.stringify(current));
              renderSectionsList();
              toast('Section moved down!');
            }
          });
        });
      }

      // 7. SITE IMAGES REPLACER
      function getSiteImages(): Record<string, string> {
        const raw = localStorage.getItem('wp_site_images');
        if (!raw) return { logo: '/assets/logo.png', founder: '/assets/founder.jpg' };
        try { return JSON.parse(raw); } catch { return { logo: '/assets/logo.png', founder: '/assets/founder.jpg' }; }
      }

      function loadImagesUI() {
        const imgs = getSiteImages();
        (document.getElementById('input-img-logo') as HTMLInputElement).value = imgs.logo || '/assets/logo.png';
        (document.getElementById('img-preview-logo') as HTMLImageElement).src = imgs.logo || '/assets/logo.png';
        (document.getElementById('input-img-founder') as HTMLInputElement).value = imgs.founder || '/assets/founder.jpg';
        (document.getElementById('img-preview-founder') as HTMLImageElement).src = imgs.founder || '/assets/founder.jpg';
      }

      document.querySelectorAll('.file-img-replacer').forEach(inp => {
        inp.addEventListener('change', (e) => {
          const target = inp.getAttribute('data-target');
          const file = (e.target as HTMLInputElement).files?.[0];
          if (file && target) {
            const r = new FileReader();
            r.onload = (ev) => {
              const b64 = ev.target?.result as string;
              const imgs = getSiteImages();
              imgs[target] = b64;
              localStorage.setItem('wp_site_images', JSON.stringify(imgs));
              loadImagesUI();
              toast(`${target} image updated across site!`);
            };
            r.readAsDataURL(file);
          }
        });
      });

      document.getElementById('input-img-logo')?.addEventListener('change', () => {
        const imgs = getSiteImages();
        imgs.logo = (document.getElementById('input-img-logo') as HTMLInputElement).value.trim();
        localStorage.setItem('wp_site_images', JSON.stringify(imgs));
        loadImagesUI();
      });

      document.getElementById('input-img-founder')?.addEventListener('change', () => {
        const imgs = getSiteImages();
        imgs.founder = (document.getElementById('input-img-founder') as HTMLInputElement).value.trim();
        localStorage.setItem('wp_site_images', JSON.stringify(imgs));
        loadImagesUI();
      });

      // 8. SECTION CONTENT COPY
      function loadSectionContent() {
        const raw = localStorage.getItem('iadverts_custom_site_content');
        if (raw) {
          try {
            const c = JSON.parse(raw);
            if (c.heroTag) (document.getElementById('wp-text-heroTag') as HTMLInputElement).value = c.heroTag;
            if (c.heroSubtitle) (document.getElementById('wp-text-heroSubtitle') as HTMLTextAreaElement).value = c.heroSubtitle;
            if (c.heroCta) (document.getElementById('wp-text-heroCta') as HTMLInputElement).value = c.heroCta;
            if (c.founderQuote) (document.getElementById('wp-text-founderQuote') as HTMLTextAreaElement).value = c.founderQuote;
            if (c.ctaHeadline) (document.getElementById('wp-text-ctaHeadline') as HTMLInputElement).value = c.ctaHeadline;
          } catch (e) {}
        }
      }

      function saveSectionContent() {
        const c: any = {};
        c.heroTag = (document.getElementById('wp-text-heroTag') as HTMLInputElement)?.value.trim();
        c.heroSubtitle = (document.getElementById('wp-text-heroSubtitle') as HTMLTextAreaElement)?.value.trim();
        c.heroCta = (document.getElementById('wp-text-heroCta') as HTMLInputElement)?.value.trim();
        c.founderQuote = (document.getElementById('wp-text-founderQuote') as HTMLTextAreaElement)?.value.trim();
        c.ctaHeadline = (document.getElementById('wp-text-ctaHeadline') as HTMLInputElement)?.value.trim();
        localStorage.setItem('iadverts_custom_site_content', JSON.stringify(c));
      }

      document.getElementById('btn-save-all-appearance')?.addEventListener('click', () => {
        saveAndApplyCurrentStyles();
        saveSectionContent();
        toast('Site Editor changes saved and published!');
      });

      // 9. MEDIA LIBRARY
      const DEFAULT_MEDIA = [
        { id: '1', name: 'logo.png', url: '/assets/logo.png', dim: '1200x442', size: '98 KB' },
        { id: '2', name: 'founder.jpg', url: '/assets/founder.jpg', dim: '800x800', size: '128 KB' },
        { id: '3', name: 'hero-3d-concept.jpg', url: '/assets/hero-3d-concept.jpg', dim: '1920x1080', size: '89 KB' }
      ];

      function getMedia() {
        const raw = localStorage.getItem('iadverts_cms_media');
        if (!raw) {
          localStorage.setItem('iadverts_cms_media', JSON.stringify(DEFAULT_MEDIA));
          return DEFAULT_MEDIA;
        }
        try { return JSON.parse(raw); } catch { return DEFAULT_MEDIA; }
      }

      function renderMediaGrid() {
        const grid = document.getElementById('wp-media-grid');
        const badge = document.getElementById('media-library-count');
        const dashBadge = document.getElementById('dash-stat-media');
        if (!grid) return;
        const list = getMedia();
        if (badge) badge.textContent = `${list.length} items`;
        if (dashBadge) dashBadge.textContent = list.length.toString();

        grid.innerHTML = list.map((item: any) => `
          <div class="bg-[#1d2327] border border-white/10 rounded-xl overflow-hidden group">
            <div class="h-24 bg-[#101517] p-2 flex items-center justify-center overflow-hidden">
              <img src="${item.url}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-2 text-[10px] font-mono border-t border-white/[0.06]">
              <div class="text-white truncate font-sans">${item.name}</div>
              <button type="button" data-copy-url="${item.url}" class="w-full mt-1.5 bg-[#2271b1]/20 hover:bg-[#2271b1] text-[#72aee6] hover:text-white py-1 rounded transition-colors text-[10px]">Copy URL</button>
            </div>
          </div>
        `).join('');

        grid.querySelectorAll('[data-copy-url]').forEach(b => {
          b.addEventListener('click', () => {
            const u = b.getAttribute('data-copy-url');
            if (u) {
              navigator.clipboard.writeText(u);
              toast('Image URL copied to clipboard!');
            }
          });
        });
      }

      document.getElementById('wp-media-upload-input')?.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files.length > 0) {
          Array.from(files).forEach(file => {
            const r = new FileReader();
            r.onload = (ev) => {
              const b64 = ev.target?.result as string;
              const media = getMedia();
              media.unshift({ id: 'm' + Date.now(), name: file.name, url: b64, dim: 'Custom', size: `${(file.size / 1024).toFixed(1)} KB` });
              localStorage.setItem('iadverts_cms_media', JSON.stringify(media));
              renderMediaGrid();
              toast(`Uploaded ${file.name}`);
            };
            r.readAsDataURL(file);
          });
        }
      });

      // 10. GENERAL SETTINGS
      document.getElementById('btn-save-wp-settings')?.addEventListener('click', () => {
        const s = {
          title: (document.getElementById('wp-set-title') as HTMLInputElement).value.trim(),
          tagline: (document.getElementById('wp-set-tagline') as HTMLInputElement).value.trim(),
          phone: (document.getElementById('wp-set-phone') as HTMLInputElement).value.trim(),
          whatsapp: (document.getElementById('wp-set-whatsapp') as HTMLInputElement).value.trim(),
          address: (document.getElementById('wp-set-address') as HTMLInputElement).value.trim()
        };
        localStorage.setItem('iadverts_site_settings', JSON.stringify(s));
        toast('General settings saved!');
      });

      // 11. PROFILE UPDATE
      document.getElementById('btn-wp-update-profile')?.addEventListener('click', () => {
        const newPwd = (document.getElementById('wp-user-new-pwd') as HTMLInputElement).value.trim();
        if (newPwd) {
          localStorage.setItem('iadverts_admin_password', newPwd);
          toast('Master Password updated!');
        } else {
          toast('Profile saved.');
        }
      });

      // 12. EXPORT BACKUP
      document.getElementById('btn-wp-export-all')?.addEventListener('click', () => {
        const backup = {
          styles: getStyles(),
          posts: getPosts(),
          sectionsOrder: getSectionOrder(),
          siteImages: getSiteImages(),
          content: localStorage.getItem('iadverts_custom_site_content'),
          settings: localStorage.getItem('iadverts_site_settings')
        };
        const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `iadvert-wordpress-backup-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        toast('Complete site backup downloaded!');
      });

      // Init on load
      refreshAuth();
      renderPostsTable();
      renderMediaGrid();
      applyStylesToUI();
      renderSectionsList();
      loadImagesUI();
      loadSectionContent();

      // ================================================================
      // PUBLISH SITE CONFIG — generates site-config.json from all edits
      // ================================================================
      const BASE_CONFIG_JSON = document.getElementById('wp-default-config')?.textContent;
      const BASE_CONFIG = BASE_CONFIG_JSON ? JSON.parse(BASE_CONFIG_JSON) : {};

      function deepClone(obj) { return JSON.parse(JSON.stringify(obj)); }

      function generateSiteConfig() {
        const base = deepClone(BASE_CONFIG);

        // --- Global Styles -> theme.colors & typography ---
        try {
          const s = JSON.parse(localStorage.getItem('wp_global_styles') || '{}');
          base.theme.colors.terra = s.terraColor ?? base.theme.colors.terra;
          base.theme.colors.terraBright = s.terraColor ?? base.theme.colors.terraBright;
          base.theme.colors.peach = s.peachColor ?? base.theme.colors.peach;
          base.theme.colors.mint = s.mintColor ?? base.theme.colors.mint;
          base.theme.colors.primary = s.bgColor ?? base.theme.colors.primary;
          base.theme.colors.surface = s.bgColor ?? base.theme.colors.surface;
          base.typography.headingFont = s.headingFont ?? base.typography.headingFont;
          base.typography.bodyFont = s.bodyFont ?? base.typography.bodyFont;
        } catch (e) {}

        // --- Section Content -> hero / founder / cta ---
        try {
          const c = JSON.parse(localStorage.getItem('iadverts_custom_site_content') || '{}');
          if (c.heroTag) base.sections.hero.tag = c.heroTag;
          if (c.heroSubtitle) base.sections.hero.subtitle = c.heroSubtitle;
          if (c.heroCta) base.sections.hero.ctaText = c.heroCta;
          if (c.founderQuote) base.sections.founder.quote = c.founderQuote;
          if (c.ctaHeadline) base.sections.cta.headline = c.ctaHeadline;
        } catch (e) {}

        // --- Site Images -> logo, founder ---
        try {
          const img = JSON.parse(localStorage.getItem('wp_site_images') || '{}');
          if (img.logo) base.brand.logo = img.logo;
          if (img.founder) base.sections.founder.image = img.founder;
        } catch (e) {}

        // --- General Settings -> brand & founder ---
        try {
          const st = JSON.parse(localStorage.getItem('iadverts_site_settings') || '{}');
          if (st.title) base.brand.name = st.title;
          if (st.tagline) base.brand.tagline = st.tagline;
          if (st.phone) base.brand.phone = st.phone;
          if (st.whatsapp) base.brand.whatsapp = st.whatsapp;
          if (st.address) base.brand.address = st.address;
          if (st.title) base.sections.founder.name = st.title;
        } catch (e) {}

        base.lastUpdated = new Date().toISOString();
        return base;
      }

      const publishBtn = document.getElementById('btn-wp-publish-config');
      const publishModal = document.getElementById('wp-modal-publish');
      const closePublishBtn = document.getElementById('btn-close-publish-modal');
      const previewEl = document.getElementById('wp-publish-preview');
      const metaEl = document.getElementById('wp-publish-meta');
      const copyBtn = document.getElementById('btn-wp-copy-config');
      const downloadBtn = document.getElementById('btn-wp-download-config');

      let generatedConfig = null;

      publishBtn?.addEventListener('click', () => {
        generatedConfig = generateSiteConfig();
        previewEl.textContent = JSON.stringify(generatedConfig, null, 2);
        metaEl.textContent = `Generated ${new Date().toLocaleString()} • ${Object.keys(generatedConfig.sections).length} sections`;
        publishModal.classList.remove('hidden');
        publishModal.classList.add('flex');
        toast('Config compiled — download site-config.json');
      });

      closePublishBtn?.addEventListener('click', () => {
        publishModal.classList.add('hidden');
        publishModal.classList.remove('flex');
      });

      copyBtn?.addEventListener('click', () => {
        if (generatedConfig) {
          navigator.clipboard.writeText(JSON.stringify(generatedConfig, null, 2));
          toast('Config JSON copied to clipboard!');
        }
      });

      downloadBtn?.addEventListener('click', () => {
        if (!generatedConfig) return;
        const blob = new Blob([JSON.stringify(generatedConfig, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'site-config.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        toast('site-config.json downloaded — replace public/site-config.json and deploy!');
      });
    </script>

    <!-- ================================================================ -->
    <!-- INDEPENDENT AUTH GATE (IIFE-scoped, Tailwind-independent storage) -->
    <!-- ================================================================ -->
    <script>
      (() => {
        let defaultKey = 'admin@iadvert2027';
        try { defaultKey = localStorage.getItem('iadverts_admin_password') || defaultKey; } catch {}

        const authGate = document.getElementById('wp-auth-gate');
        const appContainer = document.getElementById('wp-app-container');
        const loginForm = document.getElementById('wp-login-form');
        const loginPwd = document.getElementById('wp-login-pwd');
        const loginErr = document.getElementById('wp-login-error');
        const logoutBtn = document.getElementById('btn-wp-logout');

        function isAuthed() {
          try { return localStorage.getItem('iadverts_admin_authenticated') === 'true'; } catch { return false; }
        }

        function refreshAuth() {
          if (isAuthed()) {
            if (authGate) {
              authGate.style.display = 'none';
            }
            if (appContainer) {
              appContainer.style.display = 'flex';
            }
          } else {
            if (authGate) {
              authGate.style.display = 'flex';
            }
            if (appContainer) {
              appContainer.style.display = 'none';
            }
          }
        }

        // Check auth on page load
        refreshAuth();

        // Login form submit handler
        if (loginForm) {
          loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const pwd = loginPwd ? loginPwd.value.trim() : '';
            if (pwd === defaultKey) {
              try { localStorage.setItem('iadverts_admin_authenticated', 'true'); } catch {}
              if (loginErr) {
                loginErr.classList.add('hidden');
              }
              refreshAuth();
            } else {
              if (loginErr) {
                loginErr.classList.remove('hidden');
              }
              if (loginPwd) {
                loginPwd.focus();
              }
            }
          });
        }

        // Logout handler
        if (logoutBtn) {
          logoutBtn.addEventListener('click', () => {
            try { localStorage.removeItem('iadverts_admin_authenticated'); } catch {}
            refreshAuth();
          });
        }
      })();
    </script>

  </body>
</html>
