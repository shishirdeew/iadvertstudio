              >
                <svg class="w-3 h-3 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                <span>Edit</span>
              </button>

              <button
                type="button"
                data-download-post="${post.slug}"
                title="Download as .md file"
                class="liquid-glass-inner hover:bg-white/10 text-white/60 hover:text-white p-1.5 rounded-lg transition-colors"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </button>
            </div>

            <div class="flex items-center gap-1.5">
              <a
                href="/blog/${post.slug}"
                target="_blank"
                class="text-peach hover:underline text-[11px] flex items-center gap-0.5"
              >
                <span>View</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>

              <button
                type="button"
                data-delete-post="${post.slug}"
                title="Delete post"
                class="text-white/30 hover:text-terra-bright p-1 transition-colors"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    // Attach row events
    container.querySelectorAll('[data-edit-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-edit-post');
        if (slug) openEditorModal(slug);
      });
    });

    container.querySelectorAll('[data-change-cover]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-change-cover');
        if (slug) openCoverChangerModal(slug);
      });
    });

    container.querySelectorAll('[data-download-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-download-post');
        if (slug) downloadMarkdownFile(slug);
      });
    });

    container.querySelectorAll('[data-delete-post]').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-delete-post');
        if (slug && confirm('Are you sure you want to delete this article?')) {
          deletePost(slug);
        }
      });
    });
  }

  // Category filter buttons
  document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-filter-btn').forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10');
        b.classList.add('text-white/60');
      });
      btn.classList.add('active', 'text-white', 'bg-white/10', 'font-bold', 'border', 'border-white/10');
      btn.classList.remove('text-white/60');

      currentCategory = btn.getAttribute('data-cat') || 'all';
      renderPosts();
    });
  });

  // Search input handler
  document.getElementById('cms-search-input')?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderPosts();
  });

  // Export JSON backup
  document.getElementById('btn-export-json')?.addEventListener('click', () => {
    const posts = getStoredPosts();
    const blob = new Blob([JSON.stringify(posts, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `iadvert-studio-blog-backup-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('All blog posts exported as JSON!');
  });

  // Reset to default posts
  document.getElementById('btn-reset-posts')?.addEventListener('click', () => {
    if (confirm('Reset blog posts to the original 5 standard articles?')) {
      saveStoredPosts(DEFAULT_POSTS);
      renderPosts();
      showToast('Blog posts reset to default!');
    }
  });

  // Delete post
  function deletePost(slug: string) {
    const posts = getStoredPosts().filter(p => p.slug !== slug);
    saveStoredPosts(posts);
    renderPosts();
    showToast('Post deleted successfully.');
  }

  // Generate and download .md file
  function downloadMarkdownFile(slug: string) {
    const post = getStoredPosts().find(p => p.slug === slug);
    if (!post) return;

    const mdContent = `---
title: '${post.title.replace(/'/g, "''")}'
description: '${post.description.replace(/'/g, "''")}'
pubDate: ${post.pubDate}
category: '${post.category}'
readTime: '${post.readTime}'
image: '${post.image}'
featured: ${post.featured}
---

${post.body}
`;

    const blob = new Blob([mdContent], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${post.slug}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`Downloaded ${post.slug}.md for Astro content collection!`);
  }

  // ================================================================
  // FULL POST EDITOR MODAL
  // ================================================================
  const editorModal = document.getElementById('modal-post-editor');
  const modalEditorTitle = document.getElementById('modal-editor-title');
  const editPostId = document.getElementById('edit-post-id') as HTMLInputElement;
  const editTitle = document.getElementById('edit-title') as HTMLInputElement;
  const editSlug = document.getElementById('edit-slug') as HTMLInputElement;
  const editCategory = document.getElementById('edit-category') as HTMLSelectElement;
  const editReadTime = document.getElementById('edit-readtime') as HTMLInputElement;
  const editFeatured = document.getElementById('edit-featured') as HTMLInputElement;
  const editCoverUrl = document.getElementById('edit-cover-url') as HTMLInputElement;
  const editCoverPreview = document.getElementById('edit-cover-preview') as HTMLImageElement;
  const editExcerpt = document.getElementById('edit-excerpt') as HTMLTextAreaElement;
  const editBody = document.getElementById('edit-body') as HTMLTextAreaElement;

  function openEditorModal(slugToEdit?: string) {
    if (!editorModal) return;

    if (slugToEdit) {
      const post = getStoredPosts().find(p => p.slug === slugToEdit);
      if (post) {
        modalEditorTitle!.textContent = 'Edit Blog Article';
        editPostId.value = post.id;
        editTitle.value = post.title;
        editSlug.value = post.slug;
        editCategory.value = post.category;
        editReadTime.value = post.readTime;
        editFeatured.checked = post.featured;
        editCoverUrl.value = post.image;
        editCoverPreview.src = post.image;
        editExcerpt.value = post.description;
        editBody.value = post.body;
      }
    } else {
      modalEditorTitle!.textContent = 'Create New Blog Article';
      editPostId.value = '';
      editTitle.value = '';
      editSlug.value = '';
      editCategory.value = 'Meta Ads';
      editReadTime.value = '6 min read';
      editFeatured.checked = false;
      editCoverUrl.value = '/assets/hero-3d-concept.jpg';
      editCoverPreview.src = '/assets/hero-3d-concept.jpg';
      editExcerpt.value = '';
      editBody.value = `## Introduction\n\nWrite your insights here...\n\n### Key Takeaway\n\nScale consistently with Meta Ads.`;
    }

    editorModal.classList.remove('hidden');
  }

  function closeEditorModal() {
    editorModal?.classList.add('hidden');
  }

  document.getElementById('btn-create-post')?.addEventListener('click', () => openEditorModal());
  document.getElementById('btn-close-editor-modal')?.addEventListener('click', closeEditorModal);
  document.getElementById('btn-cancel-modal')?.addEventListener('click', closeEditorModal);

  // Auto slug generation from title if empty
  editTitle?.addEventListener('input', () => {
    if (!editPostId.value) {
      editSlug.value = editTitle.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
    }
  });

  // Cover URL live preview
  editCoverUrl?.addEventListener('input', () => {
    editCoverPreview.src = editCoverUrl.value;
  });

  // Preset cover buttons
  document.querySelectorAll('.btn-cover-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.getAttribute('data-preset');
      if (preset) {
        editCoverUrl.value = preset;
        editCoverPreview.src = preset;
      }
    });
  });

  // Local image file upload (FileReader -> Base64)
  document.getElementById('edit-cover-file')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const base64 = event.target?.result as string;
        editCoverUrl.value = base64;
        editCoverPreview.src = base64;
        showToast('Image uploaded and previewed!');
      };
      reader.readAsDataURL(file);
    }
  });

  // Markdown format buttons
  document.querySelectorAll<HTMLButtonElement>('.btn-md-format').forEach(btn => {
    btn.addEventListener('click', () => {
      const format = btn.getAttribute('data-format');
      const start = editBody.selectionStart;
      const end = editBody.selectionEnd;
      const text = editBody.value;
      const selected = text.substring(start, end);

      let replacement = '';
      switch (format) {
        case 'bold': replacement = `**${selected || 'bold text'}**`; break;
        case 'italic': replacement = `*${selected || 'italic text'}*`; break;
        case 'h2': replacement = `\n## ${selected || 'Heading 2'}\n`; break;
        case 'h3': replacement = `\n### ${selected || 'Heading 3'}\n`; break;
        case 'quote': replacement = `\n> ${selected || 'Important quote'}\n`; break;
        case 'list': replacement = `\n- ${selected || 'Bullet item'}\n`; break;
        case 'link': replacement = `[${selected || 'Link text'}](https://iadverts.site)`; break;
      }

      editBody.value = text.substring(0, start) + replacement + text.substring(end);
      editBody.focus();
    });
  });

  // Save Post Button
  document.getElementById('btn-save-post')?.addEventListener('click', () => {
    if (!editTitle.value.trim()) {
      alert('Please enter a title for the article.');
      return;
    }
    const slug = editSlug.value.trim() || editTitle.value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const posts = getStoredPosts();
    const existingIndex = posts.findIndex(p => p.slug === slug || (editPostId.value && p.id === editPostId.value));

    const updatedPost: BlogPostItem = {
      id: editPostId.value || slug,
      slug: slug,
      title: editTitle.value.trim(),
      description: editExcerpt.value.trim(),
      category: editCategory.value,
      readTime: editReadTime.value.trim() || '5 min read',
      pubDate: new Date().toISOString().split('T')[0],
      image: editCoverUrl.value.trim() || '/assets/hero-3d-concept.jpg',
      featured: editFeatured.checked,
      body: editBody.value.trim()
    };

    if (existingIndex >= 0) {
      posts[existingIndex] = updatedPost;
    } else {
      posts.unshift(updatedPost);
    }

    // If featured, ensure only one post is featured
    if (updatedPost.featured) {
      posts.forEach(p => {
        if (p.slug !== updatedPost.slug) p.featured = false;
      });
    }

    saveStoredPosts(posts);
    renderPosts();
    closeEditorModal();
    showToast('Post saved and published successfully!');
  });

  // Download markdown from modal
  document.getElementById('btn-download-md')?.addEventListener('click', () => {
    const slug = editSlug.value.trim() || 'post';
    const mdContent = `---
title: '${editTitle.value.replace(/'/g, "''")}'
description: '${editExcerpt.value.replace(/'/g, "''")}'
pubDate: ${new Date().toISOString().split('T')[0]}
category: '${editCategory.value}'
readTime: '${editReadTime.value}'
image: '${editCoverUrl.value}'
featured: ${editFeatured.checked}
---

${editBody.value}
`;
    const blob = new Blob([mdContent], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${slug}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`Downloaded ${slug}.md!`);
  });

