---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const rest = allPosts.filter((p) => p.slug !== featured.slug);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Layout
  title="Meta Ads Blog & Scaling Insights | iAdvert Studio"
  description="Proven frameworks, psychological creative strategies, server-side CAPI setups, and scaling playbooks from iAdvert Studio."
>
  <Navbar />
  <main class="pt-24 md:pt-32">
    <!-- Header -->
    <section class="max-w-7xl mx-auto px-6 mb-14">
      <div class="reveal">
        <div class="font-mono text-xs text-peach uppercase tracking-widest mb-3">BLOG INSIGHTS</div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight mb-5">
          Meta Advertising <span class="text-peach font-bold italic">INSIGHTS.</span>
        </h1>
        <p class="text-white/60 text-base sm:text-lg leading-relaxed max-w-2xl font-sans">
          Psychological creative, scientific architecture, and bulletproof tracking — everything you need to scale with Meta ads.
        </p>
      </div>
    </section>

    <!-- Featured post -->
    {featured && (
      <section class="max-w-7xl mx-auto px-6 mb-16 reveal reveal-up">
        <a
          href={`${base}/blog/${featured.slug}`}
          class="block liquid-glass rounded-3xl overflow-hidden grid md:grid-cols-2 border border-white/10 group hover:border-peach/40 hover:shadow-[0_20px_50px_rgba(224,72,50,0.15)] transition-all duration-300"
        >
          <div class="relative h-64 md:h-full overflow-hidden">
            <img
              src={featured.data.image}
              alt={featured.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950/80 via-obsidian-950/20 to-transparent"></div>
            <span class="absolute top-4 left-4 font-mono text-[10px] uppercase tracking-widest text-white bg-terra/80 px-3 py-1 rounded-full border border-peach/30">
              Featured
            </span>
          </div>
          <div class="p-7 sm:p-9 flex flex-col justify-center">
            <span class="font-mono text-xs text-peach uppercase tracking-widest mb-3">{featured.data.category}</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-white leading-tight mb-4 group-hover:text-peach transition-colors">
              {featured.data.title}
            </h2>
            <p class="text-white/60 text-sm sm:text-base leading-relaxed mb-6 font-sans">
              {featured.data.description}
            </p>
            <div class="flex items-center gap-4 text-white/40 text-xs font-mono">
              <span>{featured.data.readTime}</span>
              <span class="w-px h-3 bg-white/20"></span>
              <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
              <span class="ml-auto text-peach font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Read article &rarr;
              </span>
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- Posts grid -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map((post, i) => (
          <a
            href={`${base}/blog/${post.slug}`}
            class="glass-panel rounded-3xl overflow-hidden flex flex-col group border border-white/10 hover:border-peach/40 hover:shadow-[0_20px_40px_rgba(224,72,50,0.15)] transition-all duration-300 reveal reveal-up"
            style={`--reveal-delay: ${(i % 3) * 100}ms`}
          >
            <div class="relative h-48 overflow-hidden">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950/70 to-transparent"></div>
              <span class="absolute bottom-3 left-4 font-mono text-[10px] uppercase tracking-widest text-peach bg-obsidian-950/80 px-2.5 py-1 rounded-full border border-white/10">
                {post.data.category}
              </span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="font-display text-lg font-bold text-white leading-snug mb-3 line-clamp-2 group-hover:text-peach transition-colors">
                {post.data.title}
              </h3>
              <p class="text-white/60 text-sm leading-relaxed line-clamp-3 mb-5 font-sans">
                {post.data.description}
              </p>
              <div class="mt-auto flex items-center justify-between text-white/40 text-xs font-mono pt-3 border-t border-white/[0.06]">
                <span>{post.data.readTime}</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-7xl mx-auto px-6 pb-24 reveal reveal-up">
      <div class="liquid-glass rounded-3xl p-8 sm:p-12 text-center border border-white/15 max-w-3xl mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-4">
          Ready to Scale with <span class="text-peach font-bold italic">META ADS?</span>
        </h2>
        <p class="text-white/60 text-base sm:text-lg mb-7 max-w-xl mx-auto font-sans">
          Book a free audit and get a custom scaling roadmap for your brand.
        </p>
        <a
          href="https://wa.me/8801301843562?text=Hello%20Ratul,%20I%20read%20your%20blog%20and%20want%20a%20Free%20Meta%20Ads%20Audit."
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm px-6 py-3 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105"
        >
          <span>Claim Free Audit</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
