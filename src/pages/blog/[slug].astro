---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base || '/';
---

<Layout
  title={`${entry.data.title} | iAdvert Studio Blog`}
  description={entry.data.description}
>
  <Navbar />

  <main class="pt-28 md:pt-36 pb-24">
    <!-- Article Header -->
    <article class="max-w-4xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs font-mono text-white/50">
          <li>
            <a href={homeUrl} class="hover:text-peach transition-colors">Home</a>
          </li>
          <li class="text-white/30">/</li>
          <li>
            <a href={`${base}/blog`} class="hover:text-peach transition-colors">Blog</a>
          </li>
          <li class="text-white/30">/</li>
          <li class="text-white/80 truncate max-w-[200px] sm:max-w-xs" aria-current="page">
            {entry.data.title}
          </li>
        </ol>
      </nav>

      <!-- Meta Pill & Read Time -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="font-mono text-xs text-peach uppercase tracking-widest px-3 py-1 rounded-full liquid-glass-inner">
          {entry.data.category}
        </span>
        <span class="text-white/40 text-xs font-mono">•</span>
        <span class="text-white/50 text-xs font-mono">{entry.data.readTime}</span>
        <span class="text-white/40 text-xs font-mono">•</span>
        <time datetime={entry.data.pubDate.toISOString()} class="text-white/50 text-xs font-mono">
          {formattedDate}
        </time>
      </div>

      <!-- Main Title -->
      <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.15] mb-6">
        {entry.data.title}
      </h1>

      <!-- Excerpt Lead -->
      <p class="text-white/70 text-lg sm:text-xl leading-relaxed mb-10 font-sans border-l-2 border-peach/50 pl-5">
        {entry.data.description}
      </p>

      <!-- Author Card -->
      <div class="flex items-center justify-between py-5 border-y border-white/10 mb-12">
        <div class="flex items-center gap-3.5">
          <img
            src={`${base}/assets/founder.jpg`}
            alt="Ratul Ahmed Shishir"
            width="80"
            height="80"
            class="w-11 h-11 rounded-full object-cover border border-terra/50"
          />
          <div>
            <div class="text-sm font-semibold text-white">Ratul Ahmed Shishir</div>
            <div class="text-xs text-white/50 font-mono">Founder &amp; CEO, iAdvert Studio</div>
          </div>
        </div>

        <a
          href={`${base}/blog`}
          class="inline-flex items-center gap-1.5 text-xs font-mono text-peach hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>All Articles</span>
        </a>
      </div>

      <!-- Featured Image -->
      <div class="liquid-glass rounded-3xl overflow-hidden mb-14 border border-white/10">
        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="w-full h-64 sm:h-96 object-cover"
        />
      </div>

      <!-- Article Body with Markdown Styling -->
      <div class="article-content font-sans text-white/80 leading-relaxed text-base sm:text-lg space-y-6">
        <Content />
      </div>

      <!-- Post-Article CTA -->
      <div class="mt-16 liquid-glass rounded-3xl p-8 sm:p-12 text-center border border-white/15">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full liquid-glass-inner text-[11px] font-mono text-terra-bright uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-terra-bright animate-pulse"></span>
          SCALE YOUR META ADS
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-bold text-white mb-4">
          Ready to Turn Ad Dollars into <span class="text-peach font-bold italic">BANK DEPOSITS?</span>
        </h2>
        <p class="text-white/60 text-base max-w-xl mx-auto mb-8 font-sans">
          Get a complimentary 1-on-1 account audit with actionable scaling roadmap. Zero guesswork, zero obligation.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://wa.me/8801301843562?text=Hello%20Ratul,%20I%20read%20your%20blog%20and%20want%20a%20Free%20Meta%20Ads%20Audit."
            target="_blank"
            rel="noopener"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-terra-bright to-terra hover:from-[#eb4f39] hover:to-[#b53421] text-white font-semibold text-sm px-7 py-3.5 rounded-full border border-peach/20 shadow-lg shadow-terra/30 transition-all hover:scale-105"
          >
            <span>Book Free Meta Audit</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href={`${base}/blog`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 liquid-glass-inner text-white/80 hover:text-white font-medium text-sm px-6 py-3.5 rounded-full transition-colors"
          >
            <span>Back to Blog</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .article-content h2 {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .article-content h3 {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .article-content p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
  }

  .article-content ul,
  .article-content ol {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-bottom: 0.5rem;
  }

  .article-content strong {
    color: #ffffff;
    font-weight: 600;
  }

  .article-content a {
    color: #ffdad2;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .article-content a:hover {
    color: #ffffff;
  }

  .article-content blockquote {
    border-left: 3px solid #e04832;
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
  }

  .article-content hr {
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 2.5rem 0;
  }

  .article-content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .article-content th {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-weight: 600;
    text-align: left;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .article-content td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
  }

  .article-content tr:last-child td {
    border-bottom: none;
  }

  .article-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.2rem 0.45rem;
    border-radius: 0.375rem;
    color: #ffdad2;
  }
</style>
