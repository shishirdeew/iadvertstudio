---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'iAdvert Studio | Premier Meta & Facebook Ads Agency',
  description = 'We scale brands with high-performance Meta and Facebook ads. Psychological creative, scientific CBO architecture, and bulletproof CAPI tracking.',
} = Astro.props;

const siteUrl = 'https://iadverts.site';
const ogImage = `${siteUrl}/assets/hero-3d-concept.jpg`;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = currentPath ? `${siteUrl}${currentPath}/` : `${siteUrl}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'iAdvert Studio',
  description,
  url: siteUrl,
  image: ogImage,
  telephone: '+8801301843562',
  areaServed: ['Bangladesh', 'Rajshahi'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rajshahi',
    addressCountry: 'BD',
  },
  founder: {
    '@type': 'Person',
    name: 'Ratul Ahmed Shishir',
  },
  sameAs: [
    'https://www.facebook.com/iAdvertStudio',
    'https://www.instagram.com/iadvertstudio',
    'https://www.linkedin.com/company/iadvertsm/',
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c0a10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="iAdvert Studio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts (Optimized Non-Blocking with Lora Bold/Italic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- WordPress Dynamic Styles Overrides (Loaded from localStorage) -->
    <style id="wp-custom-styles"></style>
    <script is:inline>
      // Apply WordPress Global Styles & Typography immediately
      try {
        const rawStyles = localStorage.getItem('wp_global_styles');
        if (rawStyles) {
          const s = JSON.parse(rawStyles);
          const styleEl = document.getElementById('wp-custom-styles');
          let css = '';
          if (s.headingFont) {
            const fontName = s.headingFont.replace(/['"]/g, '').trim();
            if (fontName !== 'Lora' && fontName !== 'Plus Jakarta Sans') {
              const fontUrl = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(fontName)}:wght@400;600;700;800&display=swap`;
              const link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = fontUrl;
              document.head.appendChild(link);
            }
            css += `h1, h2, h3, h4, .font-display { font-family: '${fontName}', serif !important; }\n`;
          }
          if (s.bodyFont) {
            const bodyFontName = s.bodyFont.replace(/['"]/g, '').trim();
            if (bodyFontName !== 'Plus Jakarta Sans' && bodyFontName !== 'Lora') {
              const link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(bodyFontName)}:wght@400;500;600;700&display=swap`;
              document.head.appendChild(link);
            }
            css += `body, p, span, div, a, li, input, button { font-family: '${bodyFontName}', sans-serif; }\n`;
          }
          if (s.bgColor) {
            css += `html, body { background-color: ${s.bgColor} !important; }\n`;
          }
          if (s.terraColor) {
            css += `.text-terra-bright, .text-terra { color: ${s.terraColor} !important; }\n`;
            css += `.bg-terra-bright, .bg-terra { background-color: ${s.terraColor} !important; }\n`;
            css += `.border-terra, .border-terra-bright { border-color: ${s.terraColor} !important; }\n`;
          }
          if (s.peachColor) {
            css += `.text-peach { color: ${s.peachColor} !important; }\n`;
          }
          if (s.mintColor) {
            css += `.text-accent-mint { color: ${s.mintColor} !important; }\n`;
            css += `.bg-accent-mint { background-color: ${s.mintColor} !important; }\n`;
          }
          if (styleEl) styleEl.textContent = css;
        }
      } catch (e) {}

      // Apply WordPress Image Overrides
      try {
        const rawImages = localStorage.getItem('wp_site_images');
        if (rawImages) {
          const imgs = JSON.parse(rawImages);
          window.addEventListener('DOMContentLoaded', () => {
            Object.keys(imgs).forEach(key => {
              document.querySelectorAll(`[data-wp-img="${key}"]`).forEach(el => {
                if (imgs[key] && el instanceof HTMLImageElement) {
                  el.src = imgs[key];
                }
              });
            });
          });
        }
      } catch (e) {}
    </script>
  </head>
  <body
    class="bg-obsidian-900 text-[#F8F7FA] font-sans relative selection:bg-terra-bright selection:text-white"
  >
    <!-- Ambient Background Light Fields -->
    <div
      class="fixed -top-40 left-1/4 w-[600px] h-[600px] bg-radial from-terra-glow to-transparent blur-[100px] pointer-events-none z-0 animate-pulse-glow"
    >
    </div>
    <div
      class="fixed bottom-10 right-5 w-[500px] h-[500px] bg-radial from-[rgba(224,72,50,0.12)] to-transparent blur-[110px] pointer-events-none z-0"
    >
    </div>

    <!-- Subtle grain overlay for depth -->
    <div class="grain-overlay pointer-events-none fixed inset-0 z-[1] opacity-[0.035]"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <style>
      .grain-overlay {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }
    </style>

    <script>
      // Scroll-reveal for elements marked .reveal
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion) {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
    </script>

    <!-- WordPress Runtime Config Overrides -->
    <script>
      (function applySiteConfigOverrides() {
        try {
          const raw = localStorage.getItem('iadverts_site_config');
          const cfg = raw ? JSON.parse(raw) : null;
          if (cfg) applyOverrides(cfg);
        } catch (e) {}

        fetch('/site-config.json', { cache: 'force-cache' }).then(async (resp) => {
          if (resp.ok) {
            const baked = await resp.json();
            if (!localStorage.getItem('iadverts_site_config')) {
              applyOverrides(baked);
            }
          }
        }).catch(() => {});
      })();

      function applyOverrides(cfg) {
        document.querySelectorAll('[data-cfg]').forEach((el) => {
          const key = el.getAttribute('data-cfg');
          if (!key) return;
          const parts = key.split('.');
          let val = cfg;
          for (const p of parts) {
            if (!val || typeof val !== 'object') { val = undefined; break; }
            val = val[p];
          }
          if (val !== undefined && val !== null && val !== '') {
            if (el.tagName === 'IMG' && el.getAttribute('data-wp-img')) {
              el.src = String(val);
            } else {
              el.textContent = String(val);
            }
          }
        });
      }
    </script>
  </body>
</html>